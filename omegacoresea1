local currentY = 50
local function CreateToggle(name, configKey)
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0.9, 0, 0, 35)
    toggleBtn.Position = UDim2.new(0.05, 0, 0, currentY)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    toggleBtn.Text = name .. " [OFF]"
    toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    toggleBtn.Font = Enum.Font.GothamSemibold
    toggleBtn.TextSize = 14
    toggleBtn.Parent = MainFrame
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 5)
    
    currentY = currentY + 45
    
    toggleBtn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        if Config[configKey] then
            toggleBtn.Text = name .. " [ON]"
            toggleBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
        else
            toggleBtn.Text = name .. " [OFF]"
            toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end)
end

local function CreateActionBtn(name, actionFunc)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, currentY)
    btn.BackgroundColor3 = Color3.fromRGB(45, 10, 10)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 14
    btn.Parent = MainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    
    currentY = currentY + 45
    
    btn.MouseButton1Click:Connect(actionFunc)
end

