-- 3. POPULAÇÃO DINÂMICA DA UI COM TOGGLES
-- ==========================================
-- Tabela para armazenar o estado dos toggles (On/Off)
getgenv().TaskStates = getgenv().TaskStates or {}

for i, task in ipairs(missingItems) do
    local ItemFrame = Instance.new("Frame")
    ItemFrame.Size = UDim2.new(1, 0, 0, 40)
    ItemFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
    ItemFrame.BorderSizePixel = 0
    ItemFrame.Parent = ScrollingFrame

    local ItemCorner = Instance.new("UICorner")
    ItemCorner.CornerRadius = UDim.new(0, 6)
    ItemCorner.Parent = ItemFrame

    local TaskLabel = Instance.new("TextLabel")
    TaskLabel.Size = UDim2.new(0.7, 0, 1, 0)
    TaskLabel.Position = UDim2.new(0, 10, 0, 0)
    TaskLabel.BackgroundTransparency = 1
    TaskLabel.Text = task.name .. " (" .. task.category .. ")"
    TaskLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    TaskLabel.TextSize = 14
    TaskLabel.TextXAlignment = Enum.TextXAlignment.Left
    TaskLabel.Font = Enum.Font.SourceSans
    TaskLabel.Parent = ItemFrame

    -- Botão Toggle (On/Off)
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0, 60, 0, 26)
    ToggleBtn.Position = UDim2.new(1, -70, 0.5, -13)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Vermelho = OFF por padrão
    ToggleBtn.Text = "OFF"
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.TextSize = 13
    ToggleBtn.Font = Enum.Font.SourceSansBold
    ToggleBtn.Parent = ItemFrame

    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(0, 4)
    ToggleCorner.Parent = ToggleBtn

    -- Estado inicial global para essa tarefa
    getgenv().TaskStates[task.name] = false

    -- Lógica do Clique do Toggle
    ToggleBtn.MouseButton1Click:Connect(function()
        local currentState = getgenv().TaskStates[task.name]
        currentState = not currentState
        getgenv().TaskStates[task.name] = currentState

        if currentState then
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- Verde = ON
            ToggleBtn.Text = "ON"
            print("[Automation Engine] Tarefa ativada: " .. task.name)
        else
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Vermelho = OFF
            ToggleBtn.Text = "OFF"
            print("[Automation Engine] Tarefa desativada: " .. task.name)
        end
    end)
end

print("[Task Scanner] Interface gerada com sucesso! Itens pendentes encontrados: " .. #missingItems)
