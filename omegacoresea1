-- MÓDULO 1: MOTOR DE VOO INDETECTÁVEL (CURVAS DE BÉZIER)
---------------------------------------------------------------------------
-- Gera um ponto de controle aleatório para criar a curva do arco
local function getControlPoint(p0, p2)
    local distance = (p2 - p0).Magnitude
    local midPoint = p0:Lerp(p2, 0.5)
    -- Eleva o ponto de controle baseado na distância para simular um salto parabólico
    return midPoint + Vector3.new(math.random(-50, 50), distance * 0.3, math.random(-50, 50))
end

-- Fórmula Quadrática de Bézier
local function calculateBezierPoint(t, p0, p1, p2)
    return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2
end

local function SmartFly(targetPosition)
    local startPos = HumanoidRootPart.Position
    local controlPoint = getControlPoint(startPos, targetPosition)
    local duration = (startPos - targetPosition).Magnitude / 300 -- Velocidade segura
    
    local startTime = tick()
    local connection
    
    connection = RunService.Heartbeat:Connect(function()
        local elapsedTime = tick() - startTime
        local t = math.clamp(elapsedTime / duration, 0, 1)
        
        -- Bypass Anti-Cheat: Evita colisões e mantém o CFrame atualizado suavemente
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        
        local newPos = calculateBezierPoint(t, startPos, controlPoint, targetPosition)
        HumanoidRootPart.CFrame = CFrame.new(newPos, targetPosition)
        
        -- Anti-Rubberband: Zera a velocidade física para o servidor não detectar impulsos irreais
        HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
        
        if t >= 1 then
            connection:Disconnect()
        end
    end)
    
    repeat task.wait(0.1) until (HumanoidRootPart.Position - targetPosition).Magnitude < 10
end

