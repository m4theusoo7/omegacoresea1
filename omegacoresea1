-- Simulação de uso de habilidades
local function UseSkills()
    local skills = {"Z", "X", "C", "V"}
    for _, key in ipairs(skills) do
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        task.wait(0.2) -- Cooldown simulação humana
    end
end

-- Banco de dados do Sea 1 (Exemplo estrutural)
local Sea1Database = {
    Bosses = {
        {Name = "Saber Expert", Level = 200, Drop = "Saber", Pos = CFrame.new(-1461, 30, -51)},
        {Name = "Vice Admiral", Level = 130, Drop = "Vice Admiral's Coat", Pos = CFrame.new(-4807, 21, 4360)},
        {Name = "Cyborg", Level = 675, Drop = "Cool Shades", Pos = CFrame.new(6138, 10, 3939)}
    }
}

local function ScanEnvironment()
    -- Prioridade 1: Frutas Físicas (Míticas/Lendárias)
    for _, item in pairs(workspace:GetChildren()) do
        if item.Name:find("Fruit") and item:IsA("Tool") then
            -- Adicione lógica de raridade aqui se necessário
            return {Type = "Fruit", Target = item}
        end
    end
    
    -- Prioridade 2: Bosses com Drops Faltantes
    for _, bossData in pairs(Sea1Database.Bosses) do
        if not AcquiredDrops[bossData.Drop] and LocalPlayer.Data.Level.Value >= bossData.Level then
            local boss = workspace.Enemies:FindFirstChild(bossData.Name)
            if boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 then
                return {Type = "Boss", Target = boss, Data = bossData}
            end
        end
    end
    
    -- Prioridade 3: Farm Level (Acesso Sea 2)
    -- Lógica de busca do NPC de Quest correspondente ao Level do jogador iria aqui
    return {Type = "LevelFarm"}
end

local function BrainLoop()
    task.spawn(function()
        while task.wait(1) do
            if not SystemActive then continue end
            
            local objective = ScanEnvironment()
            CurrentPriority = objective.Type
            
            if objective.Type == "Fruit" then
                SmartFly(objective.Target.Handle.Position)
                firetouchinterest(HumanoidRootPart, objective.Target.Handle, 0)
                firetouchinterest(HumanoidRootPart, objective.Target.Handle, 1)
                
            elseif objective.Type == "Boss" then
                SmartFly(objective.Target.HumanoidRootPart.Position + Vector3.new(0, 15, 0))
                -- Loop de ataque
                while objective.Target.Humanoid.Health > 0 and SystemActive do
                    HumanoidRootPart.CFrame = objective.Target.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0)
                    UseSkills()
                    -- Clique do mouse (Melee/Espada)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                    task.wait(0.1)
                end
                
                -- Se o boss morrer, verificamos se ganhamos o drop via UI ou Backpack
                task.wait(2)
                if LocalPlayer.Backpack:FindFirstChild(objective.Data.Drop) then
                    AcquiredDrops[objective.Data.Drop] = true
                    writefile(BossDropsFile, HttpService:JSONEncode(AcquiredDrops))
                end
                
            elseif objective.Type == "LevelFarm" then
                -- Se não há frutas e os bosses de interesse não estão vivos, farma level
                -- Se o level for >= 700, iniciar quest do Sea 2 (Detective no Prison)
                if LocalPlayer.Data.Level.Value >= 700 then
                    -- Lógica de Quest do Sea 2 (Ice Admiral -> Sea 2)
                    SystemActive = false
                    print("Level 700 Atingido. Pronto para a Quest do Sea 2.")
                end
            end
        end
    end)
end

