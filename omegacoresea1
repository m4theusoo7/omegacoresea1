-- 🛡️ RADAR ESP INVISÍVEL (DRAWING API)
local ESP_Boxes = {}
_G.RadarEnabled = false

local function CreateESP(target)
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(255, 50, 50)
    box.Thickness = 1.5
    box.Filled = false
    box.Transparency = 1
    
    local nameText = Drawing.new("Text")
    nameText.Visible = false
    nameText.Color = Color3.fromRGB(255, 255, 255)
    nameText.Size = 14
    nameText.Center = true
    nameText.Outline = true

    ESP_Boxes[target] = {Box = box, Text = nameText}
end

RunService.RenderStepped:Connect(function()
    if not _G.RadarEnabled then
        for _, esp in pairs(ESP_Boxes) do esp.Box.Visible = false; esp.Text.Visible = false end
        return
    end
    for target, esp in pairs(ESP_Boxes) do
        if target and target:FindFirstChild("HumanoidRootPart") and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 then
            local pos, onScreen = Camera:WorldToViewportPoint(target.HumanoidRootPart.Position)
            if onScreen then
                esp.Box.Size = Vector2.new(2000 / pos.Z, 2500 / pos.Z)
                esp.Box.Position = Vector2.new(pos.X - esp.Box.Size.X / 2, pos.Y - esp.Box.Size.Y / 2)
                esp.Box.Visible = true
                esp.Text.Text = target.Name .. " [" .. math.floor(target.Humanoid.Health) .. "]"
                esp.Text.Position = Vector2.new(pos.X, pos.Y - esp.Box.Size.Y / 2 - 15)
                esp.Text.Visible = true
            else
                esp.Box.Visible = false; esp.Text.Visible = false
            end
        else
            esp.Box.Visible = false; esp.Text.Visible = false
            if esp.Box then esp.Box:Remove() end
            if esp.Text then esp.Text:Remove() end
            ESP_Boxes[target] = nil
        end
    end
end)

workspace.Enemies.ChildAdded:Connect(function(child) task.wait(0.5); CreateESP(child) end)

-- 🚀 MOTOR DE VOO BÉZIER (BYPASS ANTI-CHEAT)
local function BezierCurve(t, p0, p1, p2)
    return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2
end

local function SmartBypassMove(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local startPos = hrp.Position
    local endPos = targetCFrame.Position
    local distance = (startPos - endPos).Magnitude
    
    -- Se estiver muito perto, vai direto
    if distance < 50 then
        hrp.CFrame = targetCFrame
        return
    end

    local controlPoint = startPos:Lerp(endPos, 0.5) + Vector3.new(0, distance * 0.4, 0) -- Sobe em arco
    local speed = 300 
    local timeToTravel = math.clamp(distance / speed, 0.1, 15)
    
    local tweenValue = Instance.new("NumberValue")
    tweenValue.Value = 0
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(tweenValue, tweenInfo, {Value = 1})
    
    local connection
    connection = tweenValue.Changed:Connect(function(val)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local nextPos = BezierCurve(val, startPos, controlPoint, endPos)
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(nextPos, endPos)
        end
    end)
    
    tween:Play()
    tween.Completed:Wait()
    connection:Disconnect()
    tweenValue:Destroy()
end

