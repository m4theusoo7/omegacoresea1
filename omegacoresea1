-- Configurações e Serviços
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Coordenada exata do NPC de Missão na Pirate Starter Island
-- (Ajuste a altura 'Y' se necessário conforme o terreno da ilha)
local PirateStarterQuestNPC = CFrame.new(1062, 16, 1546) 

-- Função de Tween para mover o personagem até o NPC com segurança
local function tweenTo(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 350 -- Velocidade de voo/teletransporte ajustada para estabilidade
    local timeTake = distance / speed
    
    local tweenInfo = TweenInfo.new(timeTake, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()
end

-- Função para verificar e aceitar a missão dos Bandits (Nível 1 a 10)
local function getPirateStarterQuest()
    local playerLevel = LocalPlayer.Data.Level.Value
    
    -- Verifica se o jogador está na faixa de nível da Pirate Starter (Lv. 1 ao 9)
    if playerLevel < 10 then
        -- Verifica se já possui uma missão ativa na interface
        local questActive = LocalPlayer.PlayerGui.Main.Quest.Visible
        
        if not questActive then
            -- Se não tiver missão, vai até o NPC
            print("[OmegaCore]: Movendo para o NPC de Missão na Pirate Starter...")
            tweenTo(PirateStarterQuestNPC)
            
            task.wait(0.5)
            
            -- Dispara o evento remoto do jogo para interagir com o NPC e aceitar a missão
            if ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_") then
                -- O argumento exato aciona o diálogo do NPC de Missão dos Bandits
                ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
                print("[OmegaCore]: Missão 'BanditQuest1' aceita com sucesso!")
            end
        end
    end
end

-- Execução contínua da verificação de missão
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            getPirateStarterQuest()
        end)
    end
end)
