        _G.Config[configKey] = not _G.Config[configKey]
        Btn.Text = name .. " : " .. (_G.Config[configKey] and "ON" or "OFF")
        Btn.TextColor3 = _G.Config[configKey] and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(200, 200, 200)
    end)
end

