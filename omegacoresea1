-- ==============================================================================
-- 🛡️ 1. NOCLIP AGRESSIVO & ANTI-STUCK (Baseado nos seus testes anteriores)
-- ==============================================================================
local function AtivarNoclip()
    task.spawn(function()
        while task.wait() do
            if not getgenv().AutoFarmAtivo then break end
            local char = player.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
                -- Congela a gravidade do HRP para não brigar com o voo
                if char:FindFirstChild("HumanoidRootPart") then
                    char.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
                end
            end
        end
    end)
end

-- ==============================================================================
-- ⚔️ 2. AUTO-EQUIP E SISTEMA DE DANO CORRIGIDO
-- ==============================================================================
local function EquiparArma()
    local char = player.Character
    if not char then return end
    
    -- Tenta equipar Melee, Espada ou Fruta do inventário
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Blox Fruit") then
            char.Humanoid:EquipTool(tool)
            break
        end
    end
end

local function AtacarAlvo(target)
    if not target or not target:FindFirstChild("Humanoid") then return end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    
    if target.Humanoid.Health > 0 and hrp then
        -- Fica exatamente 7 studs ACIMA da cabeça do mob virado para baixo (evita hitbox bugada)
        hrp.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 7, 0) * CFrame.Angles(math.rad(-90), 0, 0)
        
        EquiparArma()
        
        -- Clique real garantido pelo Delta
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0,0))
        
        -- Dispara Skills (Z, X) usando KeyCodes nativos
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
        task.wait(0.1)
        vim:SendKeyEvent(true, Enum.KeyCode.X, false, game)
    else
        VirtualUser:Button1Up(Vector2.new(0,0))
    end
end

-- ==============================================================================
-- 🛸 3. VOO BÉZIER CORRIGIDO
-- ==============================================================================
local function BezierCurve(t, p0, p1, p2)
    return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2
end

local function FlyTo(targetPosition)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local startPos = hrp.Position
    local dist = (targetPosition - startPos).Magnitude
    if dist < 15 then 
        hrp.CFrame = CFrame.new(targetPosition)
        return 
    end

    local p1 = startPos:Lerp(targetPosition, 0.5) + Vector3.new(0, math.clamp(dist/3, 50, 400), 0)
    local timeToReach = dist / 300 -- 300 de velocidade limite do anti-cheat
    local startTime = tick()

    while tick() - startTime < timeToReach do
        if not getgenv().AutoFarmAtivo then break end
        local t = (tick() - startTime) / timeToReach
        hrp.CFrame = CFrame.new(BezierCurve(t, startPos, p1, targetPosition))
        task.wait()
    end
    hrp.CFrame = CFrame.new(targetPosition)
end

