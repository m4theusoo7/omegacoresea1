-- Função para identificar a quest atual com base no nível do jogador
local function GetCurrentQuest()
    local level = player.Data.Level.Value
    for _, quest in pairs(QuestList) do
        if level >= quest.Min and level <= quest.Max then
            return quest
        end
    end
    return nil
end

-- Sistema de Noclip para atravessar objetos durante o voo
RunService.Stepped:Connect(function()
    if getgenv().AutoFarm and player.Character then
        for _, v in pairs(player.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
    end
end)

-- Movimentação Suave (Tween)
local function TweenTo(targetCFrame)
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = player.Character.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 300 -- Ajuste a velocidade para evitar kicks do anti-cheat
    local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

-- Pegar Missão via Remote
local function PegarMissao(questTarget)
    local args = {
        [1] = "StartQuest",
        [2] = questTarget.QuestName,
        [3] = questTarget.QuestLevel
    }
    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer(unpack(args))
end

-- Equipar Arma/Fruta
local function EquipWeapon()
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") and (item.ToolTip == "Melee" or item.ToolTip == "Sword" or item.ToolTip == "Blox Fruit") then
            player.Character.Humanoid:EquipTool(item)
            break
        end
    end
end

-- Loop Principal de Farm
task.spawn(function()
    while task.wait() do
        if getgenv().AutoFarm then
            pcall(function()
                local questInfo = GetCurrentQuest()
                if questInfo then
                    -- Verifica se já possui a missão ativa
                    local temQuest = player.PlayerGui.Main.Quest.Visible
                    if not temQuest then
                        -- Vai até o NPC e pega a missão
                        TweenTo(questInfo.NpcPos)
