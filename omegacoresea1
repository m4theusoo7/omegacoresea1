-- [ MOTOR DE MOVIMENTAÇÃO (TWEEN / BEZIER) ]
local function FloatTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = getgenv().Config.TweenSpeed
    local time = distance / speed
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame + Vector3.new(0, 25, 0)})
    
    getgenv().CurrentTween = tween
    tween:Play()
    
    -- Ativa noclip durante o tween
    local noclipConnection
    noclipConnection = RunService.Stepped:Connect(function()
        if char:FindFirstChild("Humanoid") then
            char.Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end)
    
    tween.Completed:Wait()
    if noclipConnection then noclipConnection:Disconnect() end
end

-- [ AUTO EQUIP WEAPON ]
local function EquipWeapon()
    if not getgenv().Config.AutoEquipWeapon then return end
    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Blox Fruit" or tool.ToolTip == "Melee" or tool.ToolTip == "Sword") then
            LocalPlayer.Character.Humanoid:EquipTool(tool)
            break
        end
    end
end

-- [ AUTO SKILLS ]
local function UseSkills()
    if not getgenv().Config.AutoSkills then return end
    local vim = game:GetService("VirtualInputManager")
    local keys = {"Z", "X", "C", "V"}
    for _, key in ipairs(keys) do
        vim:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.1)
        vim:SendKeyEvent(false, Enum.KeyCode[key], false, game)
    end
end

-- [ OBTIDOR DE MISSÃO ATUAL ]
local function GetCurrentQuest()
    local level = LocalPlayer.Data.Level.Value
    local bestQuest = IslandsData[1]
    for _, data in ipairs(IslandsData) do
        if level >= data.Level then
            bestQuest = data
        end
    end
    return bestQuest
end

-- [ LOOP DE AUTO FARM LEVEL ]
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            if getgenv().Config.AutoFarmLevel and not getgenv().Config.AutoBoss then
                local questData = GetCurrentQuest()
                local questTitle = LocalPlayer.PlayerGui.Main.Quest.Visible
                
                if not questTitle then
                    -- Vai até o NPC de missão
                    FloatTo(questData.CFrame)
                    -- Simula clique/interação (Proximidade)
                    task.wait(0.5)
                else
                    -- Procura o Mob correspondente
                    local mobFolder = workspace.Enemies:GetChildren()
                    for _, mob in ipairs(mobFolder) do
                        if mob.Name:find(questData.Mob) and mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health > 0 then
                            repeat
                                task.wait()
                                EquipWeapon()
                                FloatTo(mob.HumanoidRootPart.CFrame * CFrame.new(0, 15, 0))
                                mob.HumanoidRootPart.Size = Vector3.new(60, 60, 60)
                                mob.HumanoidRootPart.CanCollide = false
                                UseSkills()
                            until not getgenv().Config.AutoFarmLevel or not mob.Parent or mob.Humanoid.Health <= 0
                        end
                    end
                end
            end
        end)
    end
end)

-- [ LOOP DE AUTO BOSS ]
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            if getgenv().Config.AutoBoss then
                local bossName = getgenv().Config.SelectedBoss
                local bossInfo = BossesData[bossName]
                
                if bossInfo then
                    local bossFound = nil
                    for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                        if enemy.Name == bossName and enemy:FindFirstChild("HumanoidRootPart") and enemy.Humanoid.Health > 0 then
                            bossFound = enemy
                            break
                        end
                    end
                    
                    if bossFound then
                        repeat
                            task.wait()
                            EquipWeapon()
                            FloatTo(bossFound.HumanoidRootPart.CFrame * CFrame.new(0, 15, 5))
                            bossFound.HumanoidRootPart.Size = Vector3.new(80, 80, 80)
                            UseSkills()
                        until not getgenv().Config.AutoBoss or not bossFound.Parent or bossFound.Humanoid.Health <= 0
                    else
                        -- Se o boss não estiver no mapa, viaja até a posição padrão dele para aguardar o spawn
                        FloatTo(bossInfo.CFrame)
                    end
                end
            end
        end)
    end
end)

