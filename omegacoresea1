local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Evita duplicação de instâncias anteriores
if PlayerGui:FindFirstChild("TaskScannerUI") then
    PlayerGui.TaskScannerUI:Destroy()
end

-- ==========================================
-- 1. MOTOR DE VARREDURA AVANÇADO (DATA CHECKER)
-- ==========================================
local function scanPlayerProgress()
    -- Tenta acessar a pasta de dados do jogador comum no Blox Fruits
    local dataFolder = LocalPlayer:FindFirstChild("Data") or LocalPlayer:FindFirstChild("leaderstats")
    
    local function hasItemOrStat(itemName)
        -- 1. Checa no Backpack ou Character (Armas, Frutas físicas)
        if LocalPlayer.Backpack:FindFirstChild(itemName) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(itemName)) then
            return true
        end
        
        -- 2. Checa em valores salvos de inventário se existirem na pasta Data
        if dataFolder then
            local inv = dataFolder:FindFirstChild("Inventory") or dataFolder:FindFirstChild("Items")
            if inv and inv:FindFirstChild(itemName) then
                return true
            end
            
            -- Checa atributos diretos (ex: Estilos de luta salvos como valores booleanos ou strings)
            for _, child in ipairs(dataFolder:GetChildren()) do
                if child.Name:lower() == itemName:lower() or (child:IsA("ValueBase") and tostring(child.Value):lower() == itemName:lower()) then
                    return true
                end
            end
        end
        
        return false
    end

    -- Base de verificação adaptada para o jogo
    local tasksToCheck = {
        { name = "Saber", category = "Armas", completed = hasItemOrStat("Saber") },
        { name = "Electro", category = "Fighting Styles", completed = hasItemOrStat("Electro") },
        { name = "Water Kung Fu", category = "Fighting Styles", completed = hasItemOrStat("Water Kung Fu") },
        { name = "Black Leg", category = "Fighting Styles", completed = hasItemOrStat("Black Leg") },
        { name = "Observation", category = "Hability", completed = hasItemOrStat("Observation") or hasItemOrStat("Ken") },
        { name = "Buso", category = "Hability", completed = hasItemOrStat("Buso") or hasItemOrStat("Armament") },
        { name = "Level 700 (Sea 2 Ready)", category = "Level", completed = (dataFolder and dataFolder:FindFirstChild("Level") and dataFolder.Level.Value >= 700) or false },
    }

    local missingTasks = {}
    for _, task in ipairs(tasksToCheck) do
        if not task.completed then
            table.insert(missingTasks, task)
        end
    end

    return missingTasks
end

local missingItems = scanPlayerProgress()

-- ==========================================
-- 2. CRIAÇÃO DA INTERFACE GRÁFICA (UI)
-- ==========================================
