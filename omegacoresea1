-- Função de Movimentação por Tween com Noclip
local function TweenTo(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = getgenv().Config.TweenSpeed
    
    local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, info, {CFrame = targetCFrame})
    
    getgenv().Tweening = true
    tween:Play()
    
    local connection
    connection = RunService.Stepped:Connect(function()
        if getgenv().Config.NoClip and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end
    end)
    
    tween.Completed:Wait()
    connection:Disconnect()
    getgenv().Tweening = false
end

-- Pega a Missão Atual com base no Level
local function GetCurrentQuest()
    local myLevel = LocalPlayer.Data.Level.Value
    for _, q in ipairs(Sea1Quests) do
        if myLevel >= q[1] and myLevel < q[2] then
            return q
        end
    end
    return Sea1Quests[1]
end

-- Loop de Auto Farm Level
task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            if getgenv().Config.AutoFarmLevel then
                local currentQuest = GetCurrentQuest()
                local questData = LocalPlayer.PlayerGui.Main.Quest
                
                -- Verifica se já tem missão ativa
                if not questData.Visible then
                    -- Vai até o NPC da missão
                    local npcPos = currentQuest[5] -- Posição aproximada do entregador/NPC
                    TweenTo(npcPos + CFrame.new(0, 10, 0))
                    
                    -- Dispara o evento de pegar missão (Simulação de clique no NPC)
                    for _, v in pairs(workspace.NPCs:GetChildren()) do
                        if v:FindFirstChild("HumanoidRootPart") and (v.HumanoidRootPart.Position - npcPos.Position).Magnitude < 15 then
                            pcall(function()
                                fireclickdetector(v.ClickDetector)
                            end)
                        end
                    end
                else
                    -- Procura pelos monstros da missão atual no workspace
                    local targetName = currentQuest[4]
                    local found = false
                    for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                        if enemy.Name == targetName and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            found = true
                            while getgenv().Config.AutoFarmLevel and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") do
                                task.wait()
                                -- Posiciona em cima/atrás do mob para evitar dano direto
                                TweenTo(enemy.HumanoidRootPart.CFrame * CFrame.new(0, 25, 3))
                                
                                -- Equipe arma/meele e ataca
                                local tool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool") or LocalPlayer.Character:FindFirstChildOfClass("Tool")
                                if tool and tool.Parent == LocalPlayer.Backpack then
                                    tool.Parent = LocalPlayer.Character
                                end
                                
                                VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                                
                                -- Auto Habilidades (Z, X, C, V)
                                if getgenv().Config.AutoSkills then
                                    local vim = game:GetService("VirtualInputManager")
                                    for _, key in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}) do
                                        vim:SendKeyEvent(true, key, false, game)
                                        task.wait(0.05)
                                        vim:SendKeyEvent(false, key, false, game)
                                    end
                                end
                            end
                        end
                    end
                    if not found then
                        task.wait(1)
                    end
                end
            end
        end)
    end
end)

