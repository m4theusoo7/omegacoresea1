-- Configurações e Serviços
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Coordenada exata do NPC de Missão na Pirate Starter Island
local PirateStarterQuestNPC = CFrame.new(1062, 16, 1546) 

-- Função de Tween para mover o personagem até o NPC com segurança
local function tweenTo(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 350
    local timeTake = distance / speed
    
    local tweenInfo = TweenInfo.new(timeTake, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()
end

-- Executa uma única vez para pegar a missão e parar
task.spawn(function()
    pcall(function()
        -- Aguarda o personagem carregar completamente no jogo
        repeat task.wait(1) until LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Data")
        
        local playerLevel = LocalPlayer.Data.Level.Value
        
        -- Verifica se está na faixa de nível da Pirate Starter
        if playerLevel < 10 then
            local questActive = LocalPlayer.PlayerGui.Main.Quest.Visible
            
            if not questActive then
                print("[OmegaCore]: Indo pegar a missão na Pirate Starter...")
                tweenTo(PirateStarterQuestNPC)
                
                task.wait(0.5)
                
                -- Dispara o evento remoto para aceitar a missão dos Bandits
                if ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_") then
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
                    print("[OmegaCore]: Missão aceita com sucesso! Script finalizado.")
                end
            else
                print("[OmegaCore]: Você já tem uma missão ativa.")
            end
        else
            print("[OmegaCore]: Nível 10 ou superior. Nenhuma ação necessária.")
        end
    end)
end)
