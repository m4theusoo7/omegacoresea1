-- Loop Principal Inteligente de Farm
task.spawn(function()
    while true do
        pcall(function()
            if getgenv().Sea1Config.AutoFarmLevel then
                local data = LocalPlayer.Data
                local level = data.Level.Value
                
                if level >= 700 then
                    getgenv().Sea1Config.CurrentStatus = "Parabéns! Nível 700 atingido no Sea 1!"
                    StatusLabel.Text = "Status: " .. getgenv().Sea1Config.CurrentStatus
                    return
                end
                
                -- Encontrar a missão adequada para o level atual
                local currentQuestData = nil
                for _, q in ipairs(Sea1Quests) do
                    if level >= q.Min and level <= q.Max then
                        currentQuestData = q
                        break
                    end
                end
                
                if currentQuestData then
                    getgenv().Sea1Config.CurrentStatus = string.Format("Level: %d\nAlvo: %s\nIlha: %s", level, currentQuestData.Mob, currentQuestData.Island)
                    StatusLabel.Text = "Status:\n" .. getgenv().Sea1Config.CurrentStatus
                    
                    EquipWeapon()
                    
                    -- Procurar Mob no Workspace
                    local enemiesFolder = Workspace.Enemies
                    local targetEnemy = nil
                    
                    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
                        if enemy.Name == currentQuestData.Mob and enemy:FindFirstChild("HumanoidRootPart") then
                            local hum = enemy:FindFirstChild("Humanoid")
                            if hum and hum.Health > 0 then
                                targetEnemy = enemy
                                break
                            end
                        end
                    end
                    
                    if targetEnemy then
                        local enemyHRP = targetEnemy.HumanoidRootPart
                        SafeTween(enemyHRP.CFrame)
                        
                        -- Ficar voando levemente acima do mob e atacar
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = enemyHRP.CFrame + Vector3.new(0, 10, 0)
                        end
                        
                        -- Atacar com clique e soltar skills
                        VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                        UseCombatSkills()
                    else
                        -- Se não achar o mob na tela, ir para a ilha padrão da quest
                        getgenv().Sea1Config.CurrentStatus = "Procurando mobs na ilha..."
                    end
                end
            end
        end)
        task.wait(0.5)
    end
end)
