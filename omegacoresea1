-- 4. MATRIZ DE PRIORIDADE DINÂMICA (IA DE DECISÃO E COMBATO)
local function VerifyInventoryForDrop(dropName)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    if (backpack and backpack:FindFirstChild(dropName)) or (character and character:FindFirstChild(dropName)) then
        return true
    end
    return false
end

-- Simulação de rotação inteligente de habilidades (Estilo de Luta, Fruta, Arma)
local function ExecuteCombatRotations(target)
    local humanoid = target:FindFirstChildOfClass("Humanoid")
    local hrp = target:FindFirstChild("HumanoidRootPart")
    
    if hrp and humanoid and humanoid.Health > 0 then
        -- Trava posição logo acima ou atrás do alvo para evitar hitboxes de dano do boss
        LocalPlayer.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 5, 2)
        
        -- Varre o inventário por armas/estilos equipáveis e cicla skills Z, X, C, V
        local tools = LocalPlayer.Backpack:GetChildren()
        for _, tool in pairs(tools) do
            if tool:IsA("Tool") then
                LocalPlayer.Character.Humanoid:EquipTool(tool)
                -- Virtual Input Simulator do Executor para disparar as teclas
                if keypress then
                    keypress(0x5A) task.wait(0.1) keyrelease(0x5A) -- Z
                    keypress(0x58) task.wait(0.1) keyrelease(0x58) -- X
                end
            end
        end
    end
end

local function BrainLoop()
    while task.wait(1) do
        if not BotState.Active then continue end
        
        local currentLevel = LocalPlayer.Data.Level.Value
        
        -- PRIORIDADE 1: FRUTA MÍTICA NO CHÃO
        local fruitFound = nil
        for _, obj in pairs(Workspace:GetChildren()) do
            if obj:IsA("Tool") and string.find(obj.name, "Fruit") then
                -- Adicione checagem de raridade real se necessário
                fruitFound = obj
                break
            end
        end
        
        if fruitFound then
            BotState.CurrentPriority = 1
            BezierTravel(fruitFound.Handle.Position, 300)
            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, fruitFound.Handle, 0)
            continue
        end
        
        -- PRIORIDADE 3: CAÇA A BOSSES COM DROP PENDENTE
        local bossTarget = nil
        for bossName, info in pairs(BOSS_DROPS) do
            if not VerifyInventoryForDrop(info.drop) then
                -- Checa se o Boss está vivo no Workspace
                local enemy = Workspace.Enemies:FindFirstChild(bossName) or Workspace._WorldOrigin:FindFirstChild(bossName)
                if enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                    bossTarget = enemy
                    break
                end
            else
                BOSS_DROPS[bossName].questDone = true
            end
        end
        
        if bossTarget then
            BotState.CurrentPriority = 3
            BezierTravel(bossTarget.HumanoidRootPart.Position, 200)
            -- Sistema de aumento de drop rate indireto: derrotar com ataques rápidos/estabilidade
            ExecuteCombatRotations(bossTarget)
            continue
        end
        
        -- PRIORIDADE 4: AUTO FARM LEVEL (PROGRESSÃO SEA 2)
        if currentLevel < MAX_SEA1_LEVEL then
            BotState.CurrentPriority = 4
            -- Código de Auto-Quest Nativo do seu Farm (Pega missão baseada no nível atual)
            -- Exemplo estrutural:
            local genericEnemy = Workspace.Enemies:GetChildren()[1]
            if genericEnemy and genericEnemy:FindFirstChild("HumanoidRootPart") then
                BezierTravel(genericEnemy.HumanoidRootPart.Position, 250)
                ExecuteCombatRotations(genericEnemy)
            end
        else
            -- CASO CHEGUE AO LEVEL 700: AUTOMATIZA MISSÃO DO SEA 2
            -- Viaja até a Prisão (Impel Down do Sea 1), fala com o Military Detective
            local detectivePos = Vector3.new(4850, 5, -750) -- Coordenadas fictícias/ilustrativas da prisão
            BezierTravel(detectivePos, 200)
            -- Dispara remote para aceitar a missão da Ice Key / lutar contra o Ice Admiral
            
            -- Após derrotar o boss do Sea 2, viaja até a Cidade Central para falar com o Capitão Experiente
            SmartServerHop() -- Muda após concluir tudo para validação de dados
            break
        end
        
        -- SE O SERVIDOR ESTIVER SECO (Sem metas válidas pendentes)
        if BotState.CurrentPriority == 4 and math.random(1, 100) > 95 then
            SmartServerHop()
        end
    end
end
task.spawn(BrainLoop)

