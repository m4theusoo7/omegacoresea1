-- [ MODULE 1: BÉZIER CURVES FLIGHT ENGINE ] --
local function GetRootPart()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
end

local function BezierFlight(targetCFrame, speed)
    local rootPart = GetRootPart()
    if not rootPart then return end
    
    speed = speed or 300
    local startPos = rootPart.Position
    local endPos = targetCFrame.Position
    
    -- Gerar ponto de controle intermediário para criar o arco (Curva Quadrática)
    local distance = (endPos - startPos).Magnitude
    local midpoint = (startPos + endPos) / 2 + Vector3.new(math.random(-50, 50), math.random(30, 80), math.random(-50, 50))
    
    local startTime = tick()
    local duration = math.max(distance / speed, 0.5)
    
    while tick() - startTime < duration do
        local root = GetRootPart()
        if not root then break end
        
        local t = (tick() - startTime) / duration
        t = math.clamp(t, 0, 1)
        
        -- Fórmula de Bézier Quadrática: B(t) = (1-t)^2 * P0 + 2(1-t)*t * P1 + t^2 * P2
        local pos = (1 - t)^2 * startPos + 2 * (1 - t) * t * midpoint + t^2 * endPos
        
        root.CFrame = CFrame.new(pos, endPos)
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        RunService.Heartbeat:Wait()
    end
    if GetRootPart() then
        GetRootPart().CFrame = targetCFrame
    end
end

-- [ COMBAT & SKILL EXECUTION ] --
local function UseEquippedSkills()
    local character = LocalPlayer.Character
    if not character then return end
    
    -- Simula pressionar as teclas de skill (Z, X, C, V, F) do item ativo
    local vim = game:GetService("VirtualInputManager")
    local skills = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F}
    
    for _, key in ipairs(skills) do
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, key, false, game)
        task.wait(0.2)
    end
end

-- [ MODULE 4: MEMORY-LEAK FREE SERVER HOP ] --
local function SmartServerHop()
    local serversUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, response = pcall(function()
        return game:HttpGet(serversUrl)
    end)
    
    if success and response then
        local data = HttpService:JSONDecode(response)
        if data and data.data then
            ProgressData.VisitedServers = ProgressData.VisitedServers or {}
            
            for _, s in ipairs(data.data) do
                if s.playing < s.maxPlayers and s.id ~= game.JobId then
                    local alreadyVisited = false
                    for _, id in ipairs(ProgressData.VisitedServers) do
                        if id == s.id then alreadyVisited = true break end
                    end
                    
                    if not alreadyVisited then
                        table.insert(ProgressData.VisitedServers, s.id)
                        if #ProgressData.VisitedServers > 50 then
                            table.remove(ProgressData.VisitedServers, 1)
                        end
                        SaveProgress(ProgressData)
                        
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                        task.wait(5)
                    end
                end
            end
        end
    end
    -- Fallback se falhar
    TeleportService:Teleport(game.PlaceId, LocalPlayer)
end

