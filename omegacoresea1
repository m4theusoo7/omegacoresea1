local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- 1. PROTEÇÃO DE UI (Otimizado para Delta)
-- ==========================================
local uiParent = pcall(gethui) and gethui() or game:GetService("CoreGui")
if uiParent:FindFirstChild("RobynhoHub") then
    uiParent.RobynhoHub:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "RobynhoHub"
ScreenGui.Parent = uiParent

-- ==========================================
-- 2. UI FLUTUANTE DRAGGABLE
-- ==========================================
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 200, 0, 120)
MainFrame.Position = UDim2.new(0.5, -100, 0.2, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
MainFrame.BorderSizePixel = 2
MainFrame.BorderColor3 = Color3.fromRGB(255, 0, 0)
MainFrame.Active = true
MainFrame.Draggable = true 
MainFrame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.Code
Title.TextSize = 14
Title.Text = "Robynho Hub - Core"
Title.Parent = MainFrame

local ToggleFarm = Instance.new("TextButton")
ToggleFarm.Size = UDim2.new(0.8, 0, 0, 35)
ToggleFarm.Position = UDim2.new(0.1, 0, 0.45, 0)
ToggleFarm.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
ToggleFarm.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleFarm.Font = Enum.Font.Code
ToggleFarm.TextSize = 14
ToggleFarm.Text = "Auto-Farm: OFF"
ToggleFarm.Parent = MainFrame

-- ==========================================
-- 3. FUNÇÕES DE COMBATE E NOCLIP
-- ==========================================
_G.AutoFarm = false

-- Noclip Limpo
RunService.Stepped:Connect(function()
    if _G.AutoFarm and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
    end
end)

-- Auto Click (Usando VirtualUser para simular clique de tela)
local function AutoClick()
    task.spawn(function()
        while _G.AutoFarm do
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new())
            task.wait(0.1)
        end
    end)
end

-- ==========================================
-- 4. LÓGICA DO BOTÃO
-- ==========================================
ToggleFarm.MouseButton1Click:Connect(function()
    _G.AutoFarm = not _G.AutoFarm
    
    if _G.AutoFarm then
        ToggleFarm.Text = "Auto-Farm: ON"
        ToggleFarm.BackgroundColor3 = Color3.fromRGB(0, 100, 0)
        
        -- Equipa a ferramenta de combate (Melee ou Espada)
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword") then
                LocalPlayer.Character.Humanoid:EquipTool(tool)
                break
            end
        end
        
        AutoClick()
    else
        ToggleFarm.Text = "Auto-Farm: OFF"
        ToggleFarm.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    end
end)
