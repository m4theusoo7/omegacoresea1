-- [ MÓDULO 3: MOTOR DE VOO (BÉZIER) ]
-- ==============================================================================
local function CalcularBezier(t, p0, p1, p2)
    return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2
end

local noclipCon
local function VooBezierInteligente(targetCFrame)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart

    if noclipCon then noclipCon:Disconnect() end
    noclipCon = RunService.Stepped:Connect(function()
        if char then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
            local bv = hrp:FindFirstChild("AntiBorracha")
            if not bv then
                bv = Instance.new("BodyVelocity", hrp)
                bv.Name = "AntiBorracha"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = Vector3.new(0, 0, 0)
            end
            hrp.Velocity = Vector3.new(0, 0, 0)
        end
    end)

    local startPos = hrp.Position
    local endPos = targetCFrame.Position
    local distance = (startPos - endPos).Magnitude
    
    if distance < 30 then
        hrp.CFrame = targetCFrame
        if noclipCon then noclipCon:Disconnect() end
        local b = hrp:FindFirstChild("AntiBorracha")
        if b then b:Destroy() end
        return true
    end

    local offset = Vector3.new(math.random(-100, 100), math.random(100, 200), math.random(-100, 100))
    local controlPoint = startPos:Lerp(endPos, 0.5) + offset
    local tempoTotal = distance / 320
    local tempoPassado = 0

    while tempoPassado < tempoTotal do
        if not getgenv().OmegaCore_AutoFarm then break end
        tempoPassado = tempoPassado + RunService.Heartbeat:Wait()
        local t = math.clamp(tempoPassado / tempoTotal, 0, 1)
        local tOtimizado = t < 0.5 and 2 * t * t or 1 - math.pow(-2 * t + 2, 2) / 2
        local novaPos = CalcularBezier(tOtimizado, startPos, controlPoint, endPos)
        hrp.CFrame = CFrame.new(novaPos, endPos)
    end

    if noclipCon then noclipCon:Disconnect() end
    local b = hrp:FindFirstChild("AntiBorracha")
    if b then b:Destroy() end
    return true
end

