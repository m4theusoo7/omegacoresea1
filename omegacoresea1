local function GetCurrentLevel()
    local stats = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level")
    if stats then return stats.Value end
    return 1
end

local function GetActiveQuest()
    local questGui = PlayerGui:FindFirstChild("Quest")
    if questGui and questGui.Visible then
        local container = questGui:FindFirstChild("Container")
        if container and container:FindFirstChild("QuestTitle") then
            return container.QuestTitle.Text
        end
    end
    return nil
end

local function GetBestQuestData()
    local lvl = GetCurrentLevel()
    local best = QuestDatabase[1]
    for _, data in ipairs(QuestDatabase) do
        if lvl >= data.Min and lvl <= data.Max then
            best = data
        end
    end
    return best
end

-- Movimentação Inteligente com interpolação suave
local function SmartTween(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local time = distance / Config.TweenSpeed
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame + Vector3.new(0, 35, 0)})
    
    tween:Play()
    return tween
end

-- Sistema de Ataque Automático por Cliques
local function TriggerAttack()
    pcall(function()
        VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
end

-- Uso Automático de Habilidades (Z, X, C, V)
local function TriggerSkills()
    if not Config.AutoSkills then return end
    local vim = game:GetService("VirtualInputManager")
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    
    for _, key in ipairs(keys) do
        pcall(function()
            vim:SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, key, false, game)
            task.wait(0.1)
        end)
    end
end

-- Motor de Tomada de Decisão (FSM Loop Principal)
task.spawn(function()
    while task.wait(0.5) do
        if Config.AutoFarm then
            pcall(function()
                local currentLvl = GetCurrentLevel()
                local questData = GetBestQuestData()
                local currentQuest = GetActiveQuest()
                
                -- Validação e Coleta de Missão
                if not currentQuest or not string.find(currentQuest, questData.NPC) then
                    EngineState.CurrentState = "GET_QUEST"
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        -- Ir até o NPC da missão
                        SmartTween(questData.Pos)
                        task.wait(1)
                        
                        -- Simular interação com o NPC de missão
                        local args = {
                            [1] = "StartQuest",
                            [2] = questData.QuestName,
                            [3] = questData.QuestIndex
                        }
                        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer(unpack(args))
                    end
                else
                    -- Estado de Farm Ativo
                    EngineState.CurrentState = "FARMING"
                    local enemiesFolder = workspace:FindFirstChild("Enemies")
                    
                    if enemiesFolder then
                        local nearestEnemy = nil
                        local shortestDist = math.huge
                        local char = LocalPlayer.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        
                        if hrp then
                            for _, enemy in ipairs(enemiesFolder:GetChildren()) do
                                if enemy.Name == questData.Mob and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                                    local dist = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        nearestEnemy = enemy
                                    end
                                end
                            end
                            
                            if nearestEnemy then
                                local enemyHRP = nearestEnemy.HumanoidRootPart
                                -- Posiciona em cima/atrás do NPC para evitar dano corpo a corpo
                                SmartTween(enemyHRP.CFrame * CFrame.new(0, 20, 3))
                                
                                -- Executa o combate automático inteligente
                                TriggerAttack()
                                TriggerSkills()
                            end
                        end
                    end
                end
            end)
        end
    end
end)

