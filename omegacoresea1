-- Função de Teletransporte Suave (Tween)
local function TweenTo(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local time = distance / Config.TweenSpeed
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame + Vector3.new(0, 15, 0)}) -- Mantém altura segura
    
    tween:Play()
    return tween
end

-- Função de Ataque Automático (Fast Attack simulado)
local function TriggerAttack()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

-- Sistema de Disparo de Habilidades (Z, X, C, V)
local function UseSkills()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local skills = {"z", "x", "c", "v"}
        for _, key in ipairs(skills) do
            vim:SendKeyEvent(true, Enum.KeyCode[key:upper()], false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, Enum.KeyCode[key:upper()], false, game)
        end
    end)
end

-- Checagem de Nível e Atualização de Ilha
local function UpdateProgress()
    pcall(function()
        local data = LocalPlayer:FindFirstChild("Data")
        if data and data:FindFirstChild("Level") then
            Config.CurrentLevel = data.Level.Value
        end
        
        if Config.CurrentLevel >= Config.TargetLevelForJungle then
            Config.CurrentIsland = "Jungle"
        else
            Config.CurrentIsland = "Starter"
        end
    end)
end

-- Loop Principal de Farm
task.spawn(function()
    while true do
        task.wait(0.5)
        if Config.AutoFarm then
            pcall(function()
                UpdateProgress()
                
                local activeQuest = LocalPlayer.PlayerGui:FindFirstChild("Main") 
                    and LocalPlayer.PlayerGui.Main:FindFirstChild("Quest") 
                    and LocalPlayer.PlayerGui.Main.Quest.Visible
                
                local currentData = Positions[Config.CurrentIsland]
                
                if not activeQuest then
                    -- Vai até o NPC pegar a missão
                    TweenTo(currentData.QuestGiver)
                    task.wait(1)
                    -- Simula clique no NPC para aceitar (interação por proximidade/remote se necessário)
                    fireclickdetector(Workspace:FindFirstChild("QuestGiver", true))
                else
                    -- Procura monstros na área
                    local enemyFolder = Workspace.Enemies
                    local targetFound = false
                    
                    for _, enemy in pairs(enemyFolder:GetChildren()) do
                        if enemy.Name == currentData.MonsterName:match("([^%s]+)") and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            targetFound = true
                            while Config.AutoFarm and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") do
                                task.wait(0.1)
                                LocalPlayer.Character.HumanoidRootPart.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0)
                                TriggerAttack()
                                UseSkills()
                            end
                        end
                    end
                    
                    if not targetFound then
                        TweenTo(currentData.MonsterPos)
                    end
                end
            end)
        end
    end
end)

