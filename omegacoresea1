--[[
    Blox Fruits - Auto Farm Funcional Level 1-10 (Starter -> Jungle)
    Otimizado para Delta Executor (Uso de VirtualUser e Remote Direto)
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- Configurações e Coordenadas
local SETTINGS = {
    MaxLevel = 10,
    QuestNPC = CFrame.new(1059.3, 16.5, 1549.5),
    MobSpawn = CFrame.new(1159.2, 16.5, 1640.8),
    JungleIsland = CFrame.new(-1251.1, 11.8, 3812.3)
}

local function getLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then
        return data.Level.Value
    end
    return 1
end

local function hasActiveQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui and playerGui:FindFirstChild("Main") then
        local quest = playerGui.Main:FindFirstChild("Quest")
        if quest and quest.Visible then
            return true
        end
    end
    return false
end

local function tweenTo(targetCFrame, speed)
    speed = speed or 350
    if not HumanoidRootPart or not HumanoidRootPart.Parent then return end
    local distance = (HumanoidRootPart.Position - targetCFrame.Position).Magnitude
    local time = distance / speed
    local tween = TweenService:Create(HumanoidRootPart, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    return tween
end

-- Função de ataque compatível com Delta (VirtualUser)
local function attackMob()
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(1000, 1000))
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(1000, 1000))
        
        -- Dispara skills automaticamente (Z, X, C)
        for _, key in ipairs({"z", "x", "c"}) do
            game:GetService("VirtualInputManager"):SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            game:GetService("VirtualInputManager"):SendKeyEvent(false, key, false, game)
        end
    end)
end

-- Loop Principal
task.spawn(function()
    print("[OmegaCore]: Iniciando Auto Farm Direto...")
    
    while true do
        task.wait(0.3)
        
        pcall(function()
            local currentLevel = getLevel()
            Character = LocalPlayer.Character
            if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
            HumanoidRootPart = Character.HumanoidRootPart
            
            if currentLevel < SETTINGS.MaxLevel then
                if not hasActiveQuest() then
                    -- Vai até o NPC e invoca a quest diretamente pelo Remote
                    tweenTo(SETTINGS.QuestNPC, 350)
                    if (HumanoidRootPart.Position - SETTINGS.QuestNPC.Position).Magnitude < 15 then
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
                        task.wait(1)
                    end
                else
                    -- Procura inimigos ativos na pasta Enemies
                    local targetMob = nil
                    local shortestDistance = math.huge
                    
                    if workspace:FindFirstChild("Enemies") then
                        for _, mob in pairs(workspace.Enemies:GetChildren()) do
                            if mob.Name == "Bandit" and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                                local mobPart = mob:FindFirstChild("HumanoidRootPart")
                                if mobPart then
                                    local dist = (HumanoidRootPart.Position - mobPart.Position).Magnitude
                                    if dist < shortestDistance then
                                        shortestDistance = dist
                                        targetMob = mobPart
                                    end
                                end
                            end
                        end
                    end
                    
                    if targetMob then
                        -- Fica em cima do mob e ataca
                        tweenTo(targetMob.CFrame + Vector3.new(0, 5, 0), 350)
                        attackMob()
                    else
                        -- Se não achar nenhum mob vivo, vai para o spawn aguardar
                        tweenTo(SETTINGS.MobSpawn + Vector3.new(0, 15, 0), 300)
                    end
                end
            else
                print("[OmegaCore]: Level 10 alcançado! Teletransportando para a Ilha Jungle...")
                local t = tweenTo(SETTINGS.JungleIsland + Vector3.new(0, 40, 0), 400)
                t.Completed:Wait()
                script:Destroy()
            end
        end)
    end
end)
