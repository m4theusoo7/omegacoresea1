-- [ MODULE 2: DYNAMIC PRIORITY AI & MAIN EXECUTION LOOP ] --
local ScriptActive = false

task.spawn(function()
    while true do
        task.wait(1)
        if ScriptActive then
            local pcallSuccess, err = pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                
                -- 1. Checar Fruta Mítica / Rara no Workspace (Prioridade 1)
                local targetFound = false
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                        -- Fruta encontrada no mapa
                        BezierFlight(obj.Handle.CFrame + Vector3.new(0, 5, 0), 350)
                        task.wait(0.5)
                        firetouchinterest(char.HumanoidRootPart, obj.Handle, 0)
                        targetFound = true
                        break
                    end
                end
                
                if targetFound then continue end
                
                -- 2. Verificar Bosses do Sea 1 pendentes de Drop (Prioridade 3)
                local currentLevel = LocalPlayer.Data.Level.Value
                local targetBoss = nil
                
                for _, boss in ipairs(Sea1Bosses) do
                    -- Se o player tem level para o boss e AINDA NÃO pegou o drop dele
                    if currentLevel >= boss.Level and not ProgressData.ObtainedDrops[boss.Drop] then
                        local bossMob = Workspace.Enemies:FindFirstChild(boss.Name) or Workspace:FindFirstChild(boss.Name)
                        if bossMob and bossMob:FindFirstChild("HumanoidRootPart") and bossMob:FindFirstChild("Humanoid") and bossMob.Humanoid.Health > 0 then
                            targetBoss = bossMob
                            break
                        else
                            -- Se o boss não está vivo no servidor atual, voar até o spawn dele para forçar spawn/aguardar
                            BezierFlight(boss.CFrame, 350)
                        end
                    end
                end
                
                if targetBoss then
                    while targetBoss and targetBoss:FindFirstChild("Humanoid") and targetBoss.Humanoid.Health > 0 and ScriptActive do
                        local root = GetRootPart()
                        if not root then break end
                        
                        root.CFrame = targetBoss.HumanoidRootPart.CFrame + Vector3.new(0, 10, 0)
                        UseEquippedSkills()
                        
                        -- Verificar se o boss dropou o item no inventário/backpack
                        for _, dropName in ipairs(Sea1Items) do
                            if LocalPlayer.Backpack:FindFirstChild(dropName) or char:FindFirstChild(dropName) then
                                for _, b in ipairs(Sea1Bosses) do
                                    if b.Drop == dropName then
                                        ProgressData.ObtainedDrops[dropName] = true
                                        SaveProgress(ProgressData)
                                    end
                                end
                            end
                        end
                        task.wait(0.3)
                    end
                    continue
                end
                
                -- 3. Farma Level Automático / Missões para Sea 2 se não houver bosses pendentes (Prioridade 4)
                if currentLevel < 700 then
                    -- Lógica de pegar missão correspondente ao level
                    local activeQuest = LocalPlayer.PlayerGui.Main.Quest.Visible
                    if not activeQuest then
                        -- Encontrar o NPC de missão adequado para o level atual
                        for _, boss in ipairs(Sea1Bosses) do
                            if currentLevel >= boss.QuestLevel and boss.QuestName then
                                -- Teleportar para o NPC de missão
                                BezierFlight(boss.CFrame + Vector3.new(5, 0, 5), 300)
                                task.wait(0.5)
                                -- Interagir com o NPC (Simular clique/prompt)
                                break
                            end
                        end
                    else
                        -- Farma os mobs da missão atual
                        for _, enemy in ipairs(Workspace.Enemies:GetChildren()) do
                            if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                                local root = GetRootPart()
                                if root then
                                    root.CFrame = enemy.HumanoidRootPart.CFrame + Vector3.new(0, 10, 0)
                                    UseEquippedSkills()
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                else
                    -- Level 700 atingido: Fazer missão de acesso ao Sea 2 (Military Detective / The Captain)
                    local detectiveCFrame = CFrame.new(4875, 5, 739) -- Exemplo de posição do detetique / porta do Sea 2
                    BezierFlight(detectiveCFrame, 300)
                    task.wait(1)
                end
                
                -- 4. Se o servidor estiver sem alvos úteis, fazer Server Hop
                local enemiesCount = #Workspace.Enemies:GetChildren()
                if enemiesCount == 0 then
                    SmartServerHop()
                end
                
            end)
            if not pcallSuccess then
                task.wait(2)
            end
        end
    end
end)

