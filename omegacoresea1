-- ==========================================
-- 3. POPULAÇÃO DOS ITENS E ESTADOS ON/OFF
-- ==========================================
getgenv().TaskStates = getgenv().TaskStates or {}

if #missingItems == 0 then
    -- Caso o jogador já tenha tudo da lista de checagem
    local EmptyLabel = Instance.new("TextLabel")
    EmptyLabel.Size = UDim2.new(1, 0, 0, 50)
    EmptyLabel.BackgroundTransparency = 1
    EmptyLabel.Text = "🎉 Nenhuma pendência encontrada! Tudo concluído."
    EmptyLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    EmptyLabel.TextSize = 14
    EmptyLabel.Font = Enum.Font.SourceSansBold
    EmptyLabel.Parent = ScrollingFrame
else
    for _, task in ipairs(missingItems) do
        local ItemFrame = Instance.new("Frame")
        ItemFrame.Size = UDim2.new(1, 0, 0, 45)
        ItemFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        ItemFrame.BorderSizePixel = 0
        ItemFrame.Parent = ScrollingFrame

        local ItemCorner = Instance.new("UICorner")
        ItemCorner.CornerRadius = UDim.new(0, 6)
        ItemCorner.Parent = ItemFrame

        local TaskLabel = Instance.new("TextLabel")
        TaskLabel.Size = UDim2.new(0.65, 0, 1, 0)
        TaskLabel.Position = UDim2.new(0, 12, 0, 0)
        TaskLabel.BackgroundTransparency = 1
        TaskLabel.Text = task.name .. "\n[" .. task.category .. "]"
        TaskLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
        TaskLabel.TextSize = 13
        TaskLabel.TextXAlignment = Enum.TextXAlignment.Left
        TaskLabel.Font = Enum.Font.SourceSans
        TaskLabel.Parent = ItemFrame

        -- Botão Toggle On/Off
        local ToggleBtn = Instance.new("TextButton")
        ToggleBtn.Size = UDim2.new(0, 70, 0, 28)
        ToggleBtn.Position = UDim2.new(1, -80, 0.5, -14)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        ToggleBtn.Text = "OFF"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ToggleBtn.TextSize = 13
        ToggleBtn.Font = Enum.Font.SourceSansBold
        ToggleBtn.Parent = ItemFrame

        local ToggleCorner = Instance.new("UICorner")
        ToggleCorner.CornerRadius = UDim.new(0, 4)
        ToggleCorner.Parent = ToggleBtn

        -- Estado padrão
        getgenv().TaskStates[task.name] = false

        ToggleBtn.MouseButton1Click:Connect(function()
            local currentState = getgenv().TaskStates[task.name]
            currentState = not currentState
            getgenv().TaskStates[task.name] = currentState

            if currentState then
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                ToggleBtn.Text = "ON"
            else
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                ToggleBtn.Text = "OFF"
            end
        end)
    end
end

print("[Scanner] Varredura concluída. Painel pronto.")
