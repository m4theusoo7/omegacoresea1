-- 2. NOCLIP DINÂMICO (Bypass Anti-Cheat)
-- ==========================================
local noclipEvent
noclipEvent = RunService.Stepped:Connect(function()
    if _G.AutoFarm then
        -- Desativa a colisão apenas quando o farm está ativo
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
    end
end)

-- ==========================================
-- 3. RADAR ESP (Drawing API) - Limpo e sem lag
-- ==========================================
_G.ESP_Ativo = true

local function CreateESP(part, name, color)
    local text = Drawing.new("Text")
    text.Visible = false
    text.Center = true
    text.Outline = true
    text.Font = 2
    text.Color = color
    text.Size = 15

    RunService.RenderStepped:Connect(function()
        if part and part.Parent and _G.ESP_Ativo and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local vector, onScreen = workspace.CurrentCamera:WorldToViewportPoint(part.Position)
            if onScreen then
                local distance = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - part.Position).Magnitude)
                text.Position = Vector2.new(vector.X, vector.Y)
                text.Text = name .. " [" .. tostring(distance) .. "m]"
                text.Visible = true
            else
                text.Visible = false
            end
        else
            text.Visible = false
        end
    end)
end

