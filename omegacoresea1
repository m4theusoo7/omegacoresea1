-- ⚔️ COMBATE: AUTO-EQUIP E USO DE SKILLS INDETECTÁVEL
-- ==============================================================================
local function EquiparArma()
    local char = player.Character
    if not char then return end
    
    -- Dá preferência para Melee (Estilo de Luta) ou Espada (Sword)
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Blox Fruit") then
            char.Humanoid:EquipTool(tool)
            break
        end
    end
end

local function UsarSkills()
    -- Aciona Z, X, C, V automaticamente da arma equipada na mão
    -- Delay curto para não travar o servidor (Spam Check)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.X, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.C, false, game)
end

local function AtacarAlvo(target)
    if not target or not target:FindFirstChild("Humanoid") then return end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    
    if target.Humanoid.Health > 0 and hrp then
        -- Fica acima do alvo (evita hitboxes bugadas no chão e ataques do mob)
        hrp.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, getgenv().Config.DistanciaAtaque, 0) * CFrame.Angles(math.rad(-90), 0, 0)
        
        EquiparArma()
        
        -- Garante que o Haki (Buso) esteja ativado se já tiver comprado
        if not player.Character:FindFirstChild("HasBuso") then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.J, false, game)
        end
        
        -- Auto Click Nativo
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0,0))
        
        UsarSkills()
    else
        -- Solta o clique quando o alvo morre
        VirtualUser:Button1Up(Vector2.new(0,0))
    end
end

