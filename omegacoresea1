local function TemItem(nomeItem)
    -- Verifica se já comprou o item/estilo de luta
    local inventario = ReplicatedStorage.Remotes.CommF_:InvokeServer("getInventory")
    for _, item in pairs(inventario) do
        if item.Name == nomeItem then return true end
    end
    -- Verifica status (Haki, Geppo, etc) salvos na Data do jogador
    -- Nota: O Blox Fruits salva estilos no CommF_, isso é uma checagem de segurança
    return false 
end

local function ChecarEComprarItens()
    if not getgenv().Config.AutoBuyItens then return end
    local dinheiro = player.Data.Beli.Value
    
    -- Tenta comprar o que está na ShopDB (Parte 1) se tiver dinheiro
    -- (A comunicação exata muda por NPC, aqui simplificamos a lógica de Request)
    if dinheiro >= 10000 and not TemItem("Geppo") then
        ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyHaki", "Geppo")
    end
    if dinheiro >= 25000 and not TemItem("Buso") then
        ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyHaki", "Buso")
    end
    if dinheiro >= 100000 and not TemItem("Soru") then
        ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyHaki", "Soru")
    end
    if dinheiro >= 150000 and not TemItem("Black Leg") then
        ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyBlackLeg")
    end
    if dinheiro >= 500000 and not TemItem("Electro") then
        ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyElectro")
    end
    if dinheiro >= 750000 and not TemItem("Water Kung Fu") then
        ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyFishmanKarate")
    end
    if dinheiro >= 750000 and not TemItem("Instinct") then
        ReplicatedStorage.Remotes.CommF_:InvokeServer("KenTalk", "Buy")
    end
end

