-- ==========================================
-- 2. LÓGICA DE MOVIMENTAÇÃO (TWEEN)
-- ==========================================
local function TweenTo(targetCFrame)
    if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = Player.Character.HumanoidRootPart
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 300
    local tweenInfo = TweenInfo.new(dist / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    hrp.Velocity = Vector3.new(0, 0, 0)
    tween:Play()
    return tween
end

local function EquipWeapon()
    for _, tool in pairs(Player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == _G.Config.Weapon then
            Player.Character.Humanoid:EquipTool(tool)
        end
    end
end

-- ==========================================
-- 3. ROTA DE FARMING (Lv 1 - 700)
-- ==========================================
local function GetFarmData()
    local lvl = Player.Data.Level.Value
    if lvl < 15 then return "Bandit Quest Giver", "Bandit"
    elseif lvl < 30 then return "Jungle Quest Giver", "Monkey"
    elseif lvl < 60 then return "Pirate Village Quest Giver", "Pirate"
    elseif lvl < 90 then return "Desert Quest Giver", "Desert Bandit"
    elseif lvl < 120 then return "Frozen Village Quest Giver", "Snow Bandit"
    elseif lvl < 150 then return "Marine Fortress Quest Giver", "Chief Petty Officer"
    elseif lvl < 190 then return "Sky Quest Giver", "Sky Bandit"
    elseif lvl < 225 then return "Prison Quest Giver", "Prisoner"
    elseif lvl < 300 then return "Colosseum Quest Giver", "Toga Warrior"
    elseif lvl < 375 then return "Magma Quest Giver", "Military Soldier"
    elseif lvl < 450 then return "Fishman Quest Giver", "Fishman Warrior"
    elseif lvl < 575 then return "Sky Quest Giver", "God's Guard"
    elseif lvl < 700 then return "Fountain Quest Giver", "Galley Pirate"
    else return "Fountain Quest Giver", "Galley Captain" end
end

-- ==========================================
-- 4. FUNÇÕES PRINCIPAIS (LOOP)
-- ==========================================
spawn(function()
    while task.wait() do
        if _G.Config.AutoFarm then
            pcall(function()
                local npcName, enemyName = GetFarmData()
                
                -- Pegar Missão
                if not Player.PlayerGui.Main.Quest.Visible then
                    local npc = workspace.NPCs:FindFirstChild(npcName)
                    if npc and npc:FindFirstChild("HumanoidRootPart") then
                        TweenTo(npc.HumanoidRootPart.CFrame)
                        if (Player.Character.HumanoidRootPart.Position - npc.HumanoidRootPart.Position).Magnitude < 10 then
                            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", npcName, 1)
                        end
                    end
                else
                    -- Matar Inimigo
                    local enemy = workspace.Enemies:FindFirstChild(enemyName)
                    if enemy and enemy:FindFirstChild("HumanoidRootPart") and enemy.Humanoid.Health > 0 then
                        EquipWeapon()
                        TweenTo(enemy.HumanoidRootPart.CFrame * CFrame.new(0, _G.Config.Distance, 0) * CFrame.Angles(math.rad(-90), 0, 0))
                        
                        -- Auto Click
                        VirtualUser:ClickButton1(Vector2.new())
                    else
                        -- Caso não ache o inimigo, esperar respawn
                        TweenTo(Player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 50, 0))
                    end
                end
            end)
        end
    end
end)

-- Auto Skills
spawn(function()
    while task.wait(0.5) do
        if _G.Config.AutoSkills and _G.Config.AutoFarm then
            pcall(function()
                local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
                for _, key in ipairs(keys) do
                    VirtualInputManager:SendKeyEvent(true, key, false, game)
                    task.wait(0.1)
                    VirtualInputManager:SendKeyEvent(false, key, false, game)
                end
            end)
        end
    end
end)

-- Fruit Sniper / Farm
spawn(function()
    while task.wait(1) do
        if _G.Config.FruitFarm then
            local achouFruta = false
            for _, v in pairs(workspace:GetChildren()) do
                if v:IsA("Tool") and string.find(v.Name, "Fruit") then
                    achouFruta = true
                    TweenTo(v.Handle.CFrame)
                    task.wait(0.5)
                end
            end
            if not achouFruta and _G.Config.ServerHop then
                -- Server Hop se não houver frutas no chão
                local Servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
                for _, server in pairs(Servers.data) do
                    if server.playing < server.maxPlayers then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, Player)
                    end
                end
            end
        end
    end
end)

