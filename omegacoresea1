-- [ MÓDULO 2: SISTEMA MEMORY-LEAK FREE SERVER HOP (PERSISTÊNCIA) ]
-- ==============================================================================
local function ExecutarServerHop()
    if not getgenv().OmegaCore_ServerHop then return end
    AtualizarRadar("Analisando", "Servidor Seco", "Iniciando Salto (Hop)...")
    
    local TPS = game:GetService("TeleportService")
    local ApiUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local visitedFile = "OmegaCore_VisitedServers.json"
    local visited = {}
    
    if isfile and isfile(visitedFile) then
        local success, result = pcall(function() return HttpService:JSONDecode(readfile(visitedFile)) end)
        if success then visited = result end
    end
    
    if #visited > 50 then visited = {} end
    table.insert(visited, game.JobId)
    if writefile then writefile(visitedFile, HttpService:JSONEncode(visited)) end

    local function Pular()
        local servers = HttpService:JSONDecode(game:HttpGet(ApiUrl))
        if servers and servers.data then
            for _, srv in pairs(servers.data) do
                if type(srv) == "table" and srv.playing < srv.maxPlayers - 1 and srv.id ~= game.JobId then
                    local jaVisitou = false
                    for _, id in pairs(visited) do
                        if id == srv.id then jaVisitou = true break end
                    end
                    if not jaVisitou then
                        TPS:TeleportToPlaceInstance(game.PlaceId, srv.id, player)
                        task.wait(5)
                    end
                end
            end
        end
    end
    pcall(Pular)
end

-- ==============================================================================
-- [ MÓDULO 3: MOTOR DE VOO INDETECTÁVEL (CURVAS DE BÉZIER) ]
-- ==============================================================================
local function CalcularBezier(t, p0, p1, p2)
    return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2
end

local noclipCon
local function VooBezierInteligente(targetCFrame)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart

    if noclipCon then noclipCon:Disconnect() end
    noclipCon = RunService.Stepped:Connect(function()
        if char then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
            hrp.Velocity = Vector3.new(0, 0, 0)
        end
    end)

    local startPos = hrp.Position
    local endPos = targetCFrame.Position
    local distance = (startPos - endPos).Magnitude
    
    if distance < 30 then
        hrp.CFrame = targetCFrame
        if noclipCon then noclipCon:Disconnect() end
        return true
    end

    -- Cria o arco matemático de desvio
    local offset = Vector3.new(math.random(-100, 100), math.random(100, 200), math.random(-100, 100))
    local controlPoint = startPos:Lerp(endPos, 0.5) + offset
    local tempoTotal = distance / 320
    local tempoPassado = 0

    while tempoPassado < tempoTotal do
        if not getgenv().OmegaCore_AutoFarm then break end
        tempoPassado = tempoPassado + RunService.Heartbeat:Wait()
        local t = math.clamp(tempoPassado / tempoTotal, 0, 1)
        
        -- Easing suave
        local tOtimizado = t < 0.5 and 2 * t * t or 1 - math.pow(-2 * t + 2, 2) / 2
        local novaPos = CalcularBezier(tOtimizado, startPos, controlPoint, endPos)
        hrp.CFrame = CFrame.new(novaPos, endPos)
    end

    if noclipCon then noclipCon:Disconnect() end
    return true
end

