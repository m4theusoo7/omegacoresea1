-- 1. MOTOR DE VOO INDETECTÁVEL (CURVAS DE BÉZIER QUADRÁTICAS)
local function GetBezierPoint(p0, p1, p2, t)
    -- Fórmula matemática: B(t) = (1-t)^2*P0 + 2(1-t)*t*P1 + t^2*P2
    local part1 = (1 - t)^2 * p0
    local part2 = 2 * (1 - t) * t * p1
    local part3 = t^2 * p2
    return part1 + part2 + part3
end

local function BezierTravel(targetPosition, speed)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local startPos = hrp.Position
    local distance = (targetPosition - startPos).Magnitude
    if distance < 10 then return end
    
    -- Cria um ponto de controle curvado para simular desvio humano e evitar detecção linear
    local controlPos = startPos:Lerp(targetPosition, 0.5) + Vector3.new(math.random(-50, 50), math.random(30, 80), math.random(-50, 50))
    
    local steps = math.ceil(distance / (speed or 25))
    for i = 1, steps do
        if not BotState.Active then break end
        local t = i / steps
        local nextPos = GetBezierPoint(startPos, controlPos, targetPosition, t)
        
        -- Aplica velocidade variável sutil simulando input analógico
        local speedModifier = 1 + (math.sin(t * math.pi) * 0.15)
        hrp.CFrame = CFrame.new(nextPos, targetPosition)
        task.wait(0.03 * (1 / speedModifier))
    end
    hrp.CFrame = CFrame.new(targetPosition)
end

-- 2. MEMORY-LEAK FREE SERVER HOP (PERSISTÊNCIA EM ARQUIVOS)
local FILE_NAME = "BloxFruits_ServerHop_Data.json"

local function LoadHopData()
    if isfile and isfile(FILE_NAME) then
        local content = readfile(FILE_NAME)
        local success, data = pcall(function() return HttpService:JSONDecode(content) end)
        if success then BotState.BlacklistedServers = data end
    end
end

local function SaveHopData()
    if writefile then
        writefile(FILE_NAME, HttpService:JSONEncode(BotState.BlacklistedServers))
    end
end

local function SmartServerHop()
    LoadHopData()
    table.insert(BotState.BlacklistedServers, game.JobId)
    SaveHopData()
    
    local servers = {}
    local req = HttpService:JSONDecode(game:HttpGet("https://roblox.com" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    
    for _, server in pairs(req.data) do
        if server.playing < server.maxPlayers and not table.find(BotState.BlacklistedServers, server.id) then
            table.insert(servers, server.id)
        end
    end
    
    if #servers > 0 then
        TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
    else
        -- Reseta a blacklist se todos os servidores já foram visitados
        BotState.BlacklistedServers = {}
        SaveHopData()
    end
end

