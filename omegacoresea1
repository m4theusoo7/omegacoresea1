-- ==========================================================
-- BLOX FRUITS - STARTER TO JUNGLE AUTO FARM (LV 1 a 10)
-- Executor: Delta Executor | Sea 1
-- ==========================================================

if getgenv().RunningStarterFarm then
    getgenv().RunningStarterFarm = false
    task.wait(0.5)
end
getgenv().RunningStarterFarm = true

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- Função de segurança para pegar o Character e HumanoidRootPart
local function getRoot()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        return char.HumanoidRootPart
    end
    return nil
end

-- Função de Tween / Teleporte suave para posições
local function smoothTween(targetCFrame, speed)
    local root = getRoot()
    if not root then return end
    
    speed = speed or 250
    local distance = (root.Position - targetCFrame.Position).Magnitude
    local timeTaken = distance / speed
    local startTime = tick()
    
    local startCFrame = root.CFrame
    while tick() - startTime < timeTaken do
        if not getgenv().RunningStarterFarm then break end
        local alpha = (tick() - startTime) / timeTaken
        root.CFrame = startCFrame:Lerp(targetCFrame, alpha)
        RunService.Heartbeat:Wait()
    end
    if getRoot() then
        getRoot().CFrame = targetCFrame
    end
end

-- Obter Level atual
local function getLevel()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats and leaderstats:FindFirstChild("Level") then
        return leaderstats.Level.Value
    end
    return 1
end

-- Detectar se é Marinha ou Pirata baseado na Equipe
local function getTeam()
    if LocalPlayer.Team and LocalPlayer.Team.Name == "Marine" then
        return "Marine"
    else
        return "Pirate"
    end
end

-- Coordenadas de referência (Sea 1)
-- NPC de missão dos bandidos (Bandit Quest Giver)
local QUEST_GIVERS = {
    Pirate = CFrame.new(1062.0, 16.5, 1424.8),  -- Perto da Pirate Starter
    Marine = CFrame.new(-2708.2, 11.9, 2045.5)   -- Perto da Marine Starter
}

-- Localização dos Bandits Lv. 5
local BANDIT_SPAWN = CFrame.new(1054.5, 16.5, 1548.8)

-- Ilha Jungle (Destino ao atingir Level 10)
local JUNGLE_ISLAND = CFrame.new(-1249.8, 11.9, 327.7)

-- Função para simular clique de ataque
local function attack()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

-- Função para usar Skills (Z, X, C, V)
local function useSkills()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        for _, key in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}) do
            vim:SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, key, false, game)
        end
    end)
end

-- Loop Principal de Automação
task.spawn(function()
    print("[Starter Farm]: Script iniciado com sucesso!")
    
    while getgenv().RunningStarterFarm do
        task.wait(0.5)
        local currentLevel = getLevel()
        
        -- Verificar se já atingiu o level 10
        if currentLevel >= 10 then
            print("[Starter Farm]: Level 10 atingido! Indo para a Ilha Jungle...")
            smoothTween(JUNGLE_ISLAND, 300)
            task.wait(1)
            print("[Starter Farm]: Chegou na Ilha Jungle. Encerrando script.")
            getgenv().RunningStarterFarm = false
            break
        end
        
        -- Checar se tem missão ativa
        local questGui = LocalPlayer.PlayerGui:FindFirstChild("Main") and LocalPlayer.PlayerGui.Main:FindFirstChild("Quest")
        local hasActiveQuest = questGui and questGui.Visible
        
        if not hasActiveQuest then
            -- 1. Ir até o Doador de Missão
            local team = getTeam()
            local giverPos = QUEST_GIVERS[team] or QUEST_GIVERS["Pirate"]
            
            print("[Starter Farm]: Indo pegar a missão de Bandidos...")
            smoothTween(giverPos, 300)
            task.wait(0.5)
            
            -- Interagir com o NPC de missão (Remotamente via ReplicatedStorage se disponível, ou encostando)
            pcall(function()
                ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
            end)
            task.wait(0.8)
        else
            -- 2. Ir até os Bandits Lv.5 e farmar
            local root = getRoot()
            if root then
                -- Posicionar levemente acima ou próximo aos bandidos para bater com segurança
                smoothTween(BANDIT_SPAWN + Vector3.new(0, 5, 0), 300)
                
                -- Ativar ataques e skills nos NPCs próximos
                for i = 1, 5 do
                    if not getgenv().RunningStarterFarm then break end
                    
                    -- Puxar / teleportar bandidos próximos para perto do player (opcional para agilizar)
                    for _, mob in ipairs(Workspace.Enemies:GetChildren()) do
                        if mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health > 0 then
                            if (mob.HumanoidRootPart.Position - BANDIT_SPAWN.Position).Magnitude < 100 then
                                mob.HumanoidRootPart.CFrame = root.CFrame * CFrame.new(0, 0, -3)
                            end
                        end
                    end
                    
                    attack()
                    if i % 2 == 0 then
                        useSkills()
                    end
                    task.wait(0.2)
                end
            end
        end
    end
end)
