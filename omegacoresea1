local function PegarMissao(npcName, questName, questLevel)
    local args = {
        [1] = "StartQuest",
        [2] = questName,
        [3] = questLevel
    }
    -- Envia a requisição direto pro servidor sem precisar clicar na UI do NPC
    ReplicatedStorage.Remotes.CommF_:InvokeServer(unpack(args))
end

