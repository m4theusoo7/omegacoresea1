local function CreateESP(instance, text, color)
    local circle = Drawing.new("Circle")
    circle.Visible = false
    circle.Radius = 15
    circle.Color = color
    circle.Thickness = 2
    circle.Filled = false

    local label = Drawing.new("Text")
    label.Visible = false
    label.Text = text
    label.Size = 18
    label.Color = color
    label.Center = true
    label.Outline = true

    table.insert(RadarObjects, {Circle = circle, Label = label, Target = instance})
end

-- Atualização contínua do Drawing API
RunService.RenderStepped:Connect(function()
    if not SystemActive then 
        for _, obj in ipairs(RadarObjects) do
            obj.Circle.Visible = false
            obj.Label.Visible = false
        end
        return 
    end

    local camera = workspace.CurrentCamera
    for _, obj in ipairs(RadarObjects) do
        if obj.Target and obj.Target.Parent and obj.Target:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = camera:WorldToViewportPoint(obj.Target.HumanoidRootPart.Position)
            if onScreen then
                obj.Circle.Position = Vector2.new(pos.X, pos.Y)
                obj.Circle.Visible = true
                
                obj.Label.Position = Vector2.new(pos.X, pos.Y - 25)
                obj.Label.Visible = true
            else
                obj.Circle.Visible = false
                obj.Label.Visible = false
            end
        else
            obj.Circle.Visible = false
            obj.Label.Visible = false
        end
    end
end)

