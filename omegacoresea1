local function UsarSkills()
    -- Ativa as skills de forma intermitente
    local vim = game:GetService("VirtualInputManager")
    vim:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
    task.wait(0.2)
    vim:SendKeyEvent(true, Enum.KeyCode.X, false, game)
    task.wait(0.2)
    vim:SendKeyEvent(true, Enum.KeyCode.C, false, game)
end

local function AtacarAlvo(target)
    if not target or not target:FindFirstChild("Humanoid") then return end
    if target.Humanoid.Health > 0 then
        -- Teleporta para cima do alvo (Evita hitbox do chão)
        character.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
        
        -- Auto Click (Mouse virtual indetectável)
        local vim = game:GetService("VirtualUser")
        vim:CaptureController()
        vim:ClickButton1(Vector2.new(0,0))
        
        UsarSkills()
    end
end

local function GetPlayerLevel()
    return player.Data.Level.Value
end

local function HasDrop(dropName)
    if dropName == "None" then return true end
    -- Checa inventário do jogador (simplificado, ajustar para o path exato do Blox Fruits)
    local inv = player:FindFirstChild("Backpack") or player.Character
    if inv:FindFirstChild(dropName) then return true end
    return false
end

-- LOOP DE IA (Roda em thread separada)
task.spawn(function()
    while task.wait(1) do
        if not _G.AutoFarmAtivo then continue end
        
        -- PRIORIDADE 1: Frutas Míticas/Raras no Chão
        local achouFruta = false
        for _, obj in pairs(workspace:GetChildren()) do
            if obj.Name:find("Fruit") and (obj.Name:find("Dragon") or obj.Name:find("Leopard") or obj.Name:find("Kitsune")) then
                _G.EstadoAtual = "Coletando Fruta Mítica: " .. obj.Name
                FlyToTarget(obj.WorldPivot.Position)
                achouFruta = true
                break
            end
        end
        if achouFruta then continue end

        -- PRIORIDADE 2: Boss com Drop pendente e Level compatível
        local bossPendente = nil
        local levelAtual = GetPlayerLevel()
        
        for _, bossData in pairs(Database.Bosses) do
            -- Farm de Boss: O Boss está vivo? Tem o nível necessário? Ainda não pegou o drop?
            if levelAtual >= bossData.Level and not HasDrop(bossData.Drop) then
                local bossModel = workspace.Enemies:FindFirstChild(bossData.Name)
                if bossModel and bossModel:FindFirstChild("Humanoid") and bossModel.Humanoid.Health > 0 then
                    bossPendente = bossModel
                    _G.EstadoAtual = "Farmando Boss para Drop: " .. bossData.Name
                    break
                end
            end
        end
        
        if bossPendente then
            FlyToTarget(bossPendente.HumanoidRootPart.Position)
            AtacarAlvo(bossPendente)
            continue
        end

        -- PRIORIDADE 3: Quest para o Sea 2
        if levelAtual >= 700 then
            _G.EstadoAtual = "Nível 700! Fazendo Quest do Sea 2..."
            -- Lógica para ir até o NPC Detective, Ice Admiral, etc.
            -- (Aqui entraria as coordenadas exatas da quest do Sea 2)
            continue
        end

        -- PRIORIDADE 4: Farm de Level Normal (Não tem boss com drop ou fruta)
        -- Nota de Otimização: Aumentar chance de drop = matar mais rápido.
        if _G.AutoHopAtivo and levelAtual < 700 then
            -- Se ligou o Auto Hop e não achou bosses com drop vivo no server, ele pula.
            IntelligentServerHop()
        else
            _G.EstadoAtual = "Farmando Nível..."
            -- Lógica padrão de pegar quest do seu nível e matar os mobs.
        end
    end
end)

