local function PossuiDrop(nomeDrop)
    local backpack = player:WaitForChild("Backpack")
    local char = player.Character
    if backpack:FindFirstChild(nomeDrop) then return true end
    if char and char:FindFirstChild(nomeDrop) then return true end
    return false
end

local function TemMissaoAtiva()
    -- Verifica se a GUI da Missão está aparecendo na tela
    local mainGui = player:WaitForChild("PlayerGui"):FindFirstChild("Main")
    if mainGui and mainGui:FindFirstChild("Quest") then
        return mainGui.Quest.Visible
    end
    return false
end

local function UsarHabilidades()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    for _, key in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}) do
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end
end

local function AnalisarMatriz()
    -- 1. Frutas Lendárias/Míticas no chão
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Tool") and string.find(obj.Name, "Fruit") then
            if string.find(obj.Name, "Dragon") or string.find(obj.Name, "Dough") or string.find(obj.Name, "Leopard") or string.find(obj.Name, "Kitsune") then
                return {Tipo = "Fruta", Part = obj.Handle, Alvo = obj}
            end
        end
    end

    -- 2. Bosses que você não tem o drop ainda
    if Workspace:FindFirstChild("Enemies") then
        for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
            for _, boss in ipairs(BossesSea1) do
                if string.find(enemy.Name, boss.Nome) and not PossuiDrop(boss.Drop) then
                    if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                        return {Tipo = "Boss", Part = enemy:FindFirstChild("HumanoidRootPart"), Alvo = enemy, Drop = boss.Drop}
                    end
                end
            end
        end
    end

    -- 3. Farme Sincronizado por Level e Missões
    local meuLevel = player.Data.Level.Value
    local zonaAtual = nil
    
    -- Busca a zona que corresponde ao seu nível
    for _, zona in ipairs(ZonasDeFarm) do
        if meuLevel >= zona.LvlMin and meuLevel <= zona.LvlMax then
            zonaAtual = zona
            break
        end
    end
    
    if zonaAtual then
        if not TemMissaoAtiva() then
            -- Precisa ir no NPC pegar a quest
            return {Tipo = "PegarMissao", Part = zonaAtual.NpcPos, Alvo = "NPC da Missão", Zona = zonaAtual}
        else
            -- A missão já tá na tela, vai caçar o Mob
            local closestMob = nil
            local shortest = math.huge
            local char = player.Character
            
            if char and char:FindFirstChild("HumanoidRootPart") and Workspace:FindFirstChild("Enemies") then
                local hrp = char.HumanoidRootPart
                for _, mob in pairs(Workspace.Enemies:GetChildren()) do
                    if string.find(mob.Name, zonaAtual.Mob) and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                        local dist = (hrp.Position - mob.HumanoidRootPart.Position).Magnitude
                        if dist < shortest then
                            shortest = dist
                            closestMob = mob
                        end
                    end
                end
            end
            
            if closestMob then
                return {Tipo = "FarmLevel", Part = closestMob.HumanoidRootPart, Alvo = closestMob, Zona = zonaAtual}
            else
                -- Os Mobs morreram e estão dando spawn, aguarda no local deles
                return {Tipo = "AguardarMob", Part = zonaAtual.MobPos, Alvo = "Aguardando " .. zonaAtual.Mob, Zona = zonaAtual}
            end
        end
    end

    return nil
end

local function IA_CerebroLoop()
    while task.wait(0.2) do
        if not getgenv().OmegaCore_AutoFarm then continue end
        
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        local hrp = char.HumanoidRootPart

        local decisao = AnalisarMatriz()

        if decisao then
            AtualizarRadar("Caçando", decisao.Alvo.Name or decisao.Alvo, "Modo: " .. decisao.Tipo)
            local dist = (hrp.Position - (typeof(decisao.Part) == "CFrame" and decisao.Part.Position or decisao.Part.Position)).Magnitude

            if decisao.Tipo == "PegarMissao" then
                if dist > 15 then
                    VooBezierInteligente(decisao.Part) -- Voa até o NPC
                else
                    -- Chama o servidor para ativar a missão na sua tela
                    local args = {
                        [1] = "StartQuest",
                        [2] = decisao.Zona.Quest,
                        [3] = decisao.Zona.QuestLevel
                    }
                    ReplicatedStorage.Remotes.CommF_:InvokeServer(unpack(args))
                    task.wait(1)
                end
                
            elseif decisao.Tipo == "FarmLevel" or decisao.Tipo == "Boss" then
                if dist > 15 then
                    -- Voa até o inimigo, parando 10 studs acima
                    local cframeDestino = typeof(decisao.Part) == "CFrame" and decisao.Part or decisao.Part.CFrame
                    VooBezierInteligente(cframeDestino * CFrame.new(0, 10, 0))
                else
                    local pos = typeof(decisao.Part) == "CFrame" and decisao.Part.Position or decisao.Part.Position
                    hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(pos.X, hrp.Position.Y, pos.Z))
                    UsarHabilidades()
                end
                
            elseif decisao.Tipo == "AguardarMob" then
                if dist > 15 then
                    VooBezierInteligente(decisao.Part * CFrame.new(0, 20, 0)) -- Fica pairando acima do spawn
                end
            elseif decisao.Tipo == "Fruta" then
                if dist > 10 then
                    VooBezierInteligente(decisao.Part.CFrame)
                else
                    hrp.CFrame = decisao.Part.CFrame
                end
            end
        else
            AtualizarRadar("Limpeza Completa", "Servidor Seco", "Avaliando Server Hop...")
            if getgenv().OmegaCore_ServerHop then
                ExecutarServerHop()
                task.wait(10)
            end
        end
    end
end

