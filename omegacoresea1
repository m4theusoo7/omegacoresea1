-- 🚀 FÍSICA: NOCLIP & ANTI-STUCK (LinearVelocity Override)
-- ==============================================================================
local function EnableNoclip()
    task.spawn(function()
        while task.wait() do
            if not getgenv().Config.AutoFarm then break end
            local char = player.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end

-- ==============================================================================
-- 🛸 VOO BÉZIER (BYPASS ANTI-CHEAT)
-- ==============================================================================
local function Bezier(t, p0, p1, p2)
    return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2
end

local function TweenVoo(targetPos)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    -- Congela gravidade durante o voo
    hrp.Velocity = Vector3.new(0,0,0)
    
    local startPos = hrp.Position
    local distance = (targetPos - startPos).Magnitude
    
    if distance < 15 then 
        hrp.CFrame = CFrame.new(targetPos)
        return 
    end

    -- Ponto alto da parábola de voo
    local altura = math.clamp(distance/3, 50, 400)
    local p1 = startPos:Lerp(targetPos, 0.5) + Vector3.new(0, altura, 0)
    local timeToReach = distance / 300 -- Velocidade segura Blox Fruits
    local startTime = tick()

    while tick() - startTime < timeToReach do
        if not getgenv().Config.AutoFarm then break end
        local t = (tick() - startTime) / timeToReach
        hrp.CFrame = CFrame.new(Bezier(t, startPos, p1, targetPos))
        task.wait()
    end
    
    hrp.CFrame = CFrame.new(targetPos)
end

-- ==============================================================================
-- ♻️ GERENCIADOR DE SERVIDOR (HOP LIVRE DE MEMORY LEAK)
-- ==============================================================================
local function ServerHopInteligente()
    local fileName = "BloxFruits_HopData.json"
    local serversVisitados = {}

    -- Lê o arquivo se existir
    if isfile(fileName) then
        local suc, dec = pcall(function() return HttpService:JSONDecode(readfile(fileName)) end)
        if suc and type(dec) == "table" then serversVisitados = dec end
    end

    -- Adiciona o servidor atual para não voltar
    table.insert(serversVisitados, game.JobId)
    if #serversVisitados > 50 then table.remove(serversVisitados, 1) end
    writefile(fileName, HttpService:JSONEncode(serversVisitados))

    print("[IA] Procurando novo servidor...")
    
    local success, response = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)
    
    if success then
        local data = HttpService:JSONDecode(response)
        if data and data.data then
            for _, srv in pairs(data.data) do
                if srv.playing < srv.maxPlayers - 1 and srv.id ~= game.JobId then
                    local jaVisitado = false
                    for _, visitadoId in pairs(serversVisitados) do
                        if srv.id == visitadoId then jaVisitado = true break end
                    end
                    if not jaVisitado then
                        print("[IA] Pulando para o servidor: " .. srv.id)
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, player)
                        task.wait(10)
                    end
                end
            end
        end
    end
end

