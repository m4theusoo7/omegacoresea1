local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- Configurações de Ilhas e Alvos
local SETTINGS = {
    StarterLevelMax = 10,
    StarterIsland = CFrame.new(979.8, 16.5, 1419.2), -- Posição aproximada Starter Island
    JungleIsland = CFrame.new(-1251.1, 11.8, 3812.3), -- Posição aproximada Jungle
}

-- Função para verificar o level atual
local function getLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then
        return data.Level.Value
    end
    return 1
end

-- Função de movimento suave (Tween)
local function tweenTo(targetCFrame, speed)
    speed = speed or 250
    local distance = (HumanoidRootPart.Position - targetCFrame.Position).Magnitude
    local time = distance / speed
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(HumanoidRootPart, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    return tween
end

-- Função para usar Ataques e Skills
local function attackTarget()
    -- Simula clique de ataque básico
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    
    -- Dispara skills (Z, X, C, V)
    local vim = game:GetService("VirtualInputManager")
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, key, false, game)
    end
end

