-- // Omega Core: Pirate Starter Quest & Auto Farm
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")

local LocalPlayer = Players.LocalPlayer

-- Anti-AFK
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

getgenv().Config = {
    AutoFarmQuest = true,
    AutoAttack = true,
    UseSkills = true,
    SelectedWeapon = "Combat" -- Mude para sua arma equipada, ex: "Melee", "Sword"
}

-- Função para equipar arma
local function EquipWeapon(toolName)
    local character = LocalPlayer.Character
    if not character then return end
    local backpack = LocalPlayer.Backpack
    
    local tool = character:FindFirstChild(toolName) or backpack:FindFirstChild(toolName)
    if tool and tool:IsA("Tool") and tool.Parent == backpack then
        character.Humanoid:EquipTool(tool)
    end
end

-- Função de Ataque Automático
task.spawn(function()
    while task.wait(0.1) do
        if getgenv().Config.AutoAttack then
            pcall(function()
                EquipWeapon(getgenv().Config.SelectedWeapon)
                VirtualUser:Button1Down(Vector2.new(100, 100), Workspace.CurrentCamera.CFrame)
                task.wait(0.05)
                VirtualUser:Button1Up(Vector2.new(100, 100), Workspace.CurrentCamera.CFrame)
            end)
        end
    end
end)

-- Sistema de Disparo de Skills (Z, X, C, V)
task.spawn(function()
    while task.wait(0.4) do
        if getgenv().Config.UseSkills then
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
                for _, key in ipairs(keys) do
                    vim:SendKeyEvent(true, key, false, game)
                    task.wait(0.05)
                    vim:SendKeyEvent(false, key, false, game)
                    task.wait(0.1)
                end
            end)
        end
    end
end)

-- Pegar Missão e Farmar na Pirate Starter
task.spawn(function()
    while task.wait(1) do
        if getgenv().Config.AutoFarmQuest then
            pcall(function()
                local character = LocalPlayer.Character
                if not character or not character:FindFirstChild("HumanoidRootPart") then return end
                
                local hrp = character.HumanoidRootPart
                local questGui = LocalPlayer.PlayerGui:FindFirstChild("Main"):FindFirstChild("Quest")
                
                -- Se não tiver missão ativa, pega com o NPC da Pirate Starter
                if not questGui.Visible then
                    -- Teleporta para o NPC de missão da Pirate Starter
                    local questGiver = Workspace.NPCs:FindFirstChild("Adventurer") or Workspace._Map:FindFirstChild("QuestGivers", true)
                    
                    -- Se aproximar do NPC para pegar a missão
                    if Workspace.Enemies:FindFirstChild("Bandit") then
                        -- Aqui você pode ajustar para ir até o NPC exato da Pirate Starter
                        hrp.CFrame = CFrame.new(1062, 16, 1441) -- Coordenada aproximada do NPC da Pirate Starter
                        task.wait(0.5)
                        -- Simular clique ou interação se necessário
                    end
                else
                    -- Se a missão estiver ativa, vai atrás dos Bandits da Pirate Starter
                    local enemyFolder = Workspace.Enemies
                    for _, enemy in pairs(enemyFolder:GetChildren()) do
                        if enemy.Name == "Bandit" and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            repeat
                                task.wait()
                                if not character:FindFirstChild("HumanoidRootPart") then break end
                                hrp.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 10, 3) -- Fica ligeiramente acima/atrás para evitar dano direto
                            until not enemy or not enemy.Parent or enemy.Humanoid.Health <= 0 or not getgenv().Config.AutoFarmQuest
                        end
                    end
                end
            end)
        end
    end
end)

