-- Garante que o Executor suporte as funções básicas
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Evita duplicação de instâncias anteriores
if PlayerGui:FindFirstChild("TaskScannerUI") then
    PlayerGui.TaskScannerUI:Destroy()
end

-- ==========================================
-- 1. MOTOR DE VARREDURA (SCANNER)
-- ==========================================
local function scanPlayerProgress()
    local inventory = {}
    
    -- Mapeia itens no inventário (Backpack + Character)
    local function checkItem(name)
        local has = false
        if LocalPlayer.Backpack:FindFirstChild(name) or LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(name) then
            has = true
        end
        -- Nota: Em jogos como Blox Fruits, muitos dados ficam em RemoteFolders ou PlayerValues. 
        -- Aqui simulamos a checagem padrão de instâncias e atributos.
        return has
    end

    -- Exemplo de base de dados de verificação para o Sea 1 / Geral
    local tasksToCheck = {
        { name = "Saber (Espada)", category = "Armas", completed = checkItem("Saber") },
        { name = "Electro (Estilo de Luta)", category = "Fighting Styles", completed = checkItem("Electro") },
        { name = "Water Kung Fu", category = "Fighting Styles", completed = checkItem("Water Kung Fu") },
        { name = "Black Leg", category = "Fighting Styles", completed = checkItem("Black Leg") },
        { name = "Cape (Acessório)", category = "Acessórios", completed = checkItem("Black Cape") or checkItem("Green Cape") },
        { name = "Chegar ao Nível Máximo (Sea 1)", category = "Level", completed = (LocalPlayer.Data.Level.Value >= 700) },
        { name = "Desbloquear Haki da Observação", category = "Hability", completed = checkItem("Observation") },
    }

    local missingTasks = {}
    for _, task in ipairs(tasksToCheck) do
        if not task.completed then
            table.insert(missingTasks, task)
        end
    end

    return missingTasks
end

local missingItems = scanPlayerProgress()

