local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local BrainActive = false

-- Tabela de Pesos e Prioridades (A "Personalidade" do Motor)
local Weights = {
    FruitSpawn = 1000, -- Prioridade absoluta
    BossDropPending = 500,
    QuestProgress = 100,
    LevelGrind = 50
}

-- [ MOTOR DE CÁLCULO EM TEMPO REAL ] --
local function EvaluateAndDecide()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local root = character.HumanoidRootPart
    local currentLevel = LocalPlayer.Data.Level.Value
    
    -- 1. ANÁLISE DE PERCEPÇÃO: Verificar Frutas (Maior Urgência)
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
            -- Calculamos o custo (distância) até a fruta
            local distance = (obj.Handle.Position - root.Position).Magnitude
            return {
                Action = "COLLECT_FRUIT",
                Target = obj.Handle,
                UtilityScore = Weights.FruitSpawn - distance -- Quanto mais perto, maior a urgência real
            }
        end
    end
    
    -- 2. ANÁLISE DE PERCEPÇÃO: Verificar Bosses com Drops Pendentes
    -- (Aqui entraria a checagem no seu banco de dados local via readfile)
    local targetBoss = Workspace.Enemies:FindFirstChild("Gorilla King") -- Exemplo
    if targetBoss and targetBoss:FindFirstChild("Humanoid") and targetBoss.Humanoid.Health > 0 then
        local distance = (targetBoss.HumanoidRootPart.Position - root.Position).Magnitude
        return {
            Action = "HUNT_BOSS",
            Target = targetBoss,
            UtilityScore = Weights.BossDropPending - (distance * 0.5)
        }
    end
    
    -- 3. ANÁLISE DE PERCEPÇÃO: Missão e Level Up
    if currentLevel < 700 then
        return {
            Action = "GRIND_LEVEL_OR_QUEST",
            UtilityScore = Weights.LevelGrind
        }
    end
    
    return { Action = "IDLE", UtilityScore = 0 }
end

-- [ LOOP DO CÉREBRO AUTÔNOMO ] --
task.spawn(function()
    while true do
        task.wait(0.2) -- O motor recalcula o ambiente 5 vezes por segundo
        if BrainActive then
            -- O motor calcula o que fazer AGORA com base no estado atual
            local decision = EvaluateAndDecide()
            
            if decision.Action == "COLLECT_FRUIT" then
                -- Executa voo suave por Bézier até a fruta
                print("[AI Brain] Decisão: Coletar Fruta | Prioridade:", decision.UtilityScore)
                -- ...
            elseif decision.Action == "HUNT_BOSS" then
                print("[AI Brain] Decisão: Caçar Boss | Prioridade:", decision.UtilityScore)
                -- ...
            elseif decision.Action == "GRIND_LEVEL_OR_QUEST" then
                print("[AI Brain] Decisão: Farma de Level/Missão | Prioridade:", decision.UtilityScore)
                -- ...
            end
        end
    end
end)
