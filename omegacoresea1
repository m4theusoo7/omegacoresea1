-- 📁 MÓDULO 4: MEMORY-LEAK FREE SERVER HOP (Persistência)
-- ==============================================================================
local HopConfig = {
    FileName = "BloxFruits_Sea1_HopData.json",
    MaxSavedServers = 50
}

local function GetSavedServers()
    if isfile(HopConfig.FileName) then
        local success, data = pcall(function() return HttpService:JSONDecode(readfile(HopConfig.FileName)) end)
        if success and type(data) == "table" then return data end
    end
    return {}
end

local function SaveCurrentServer()
    local servers = GetSavedServers()
    table.insert(servers, game.JobId)
    if #servers > HopConfig.MaxSavedServers then table.remove(servers, 1) end
    writefile(HopConfig.FileName, HttpService:JSONEncode(servers))
end

local function IntelligentServerHop()
    _G.EstadoAtual = "Buscando novo servidor..."
    SaveCurrentServer()
    local servers = GetSavedServers()
    
    local success, response = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
    end)
    
    if success then
        local data = HttpService:JSONDecode(response)
        if data and data.data then
            for _, srv in pairs(data.data) do
                if srv.playing < srv.maxPlayers - 1 and srv.id ~= game.JobId then
                    local alreadyVisited = false
                    for _, v in pairs(servers) do
                        if v == srv.id then alreadyVisited = true break end
                    end
                    if not alreadyVisited then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, player)
                        return
                    end
                end
            end
        end
    end
end

-- ==============================================================================
-- 🛸 MÓDULO 1: MOTOR DE VOO INDETECTÁVEL (CURVAS DE BÉZIER)
-- ==============================================================================
-- Gera um movimento suave em arco para enganar o anti-cheat
local function BezierCurve(t, p0, p1, p2)
    return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2
end

local function FlyToTarget(targetPosition)
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart
    local startPos = hrp.Position
    
    -- Calcula o ponto de controle P1 (um arco no céu)
    local distance = (targetPosition - startPos).Magnitude
    local heightOffset = math.clamp(distance / 4, 50, 300) -- Sobe dependendo da distância
    local p1 = startPos:Lerp(targetPosition, 0.5) + Vector3.new(0, heightOffset, 0)
    
    local speed = 300 -- Velocidade segura para o Anti-Cheat do Blox Fruits
    local timeToReach = distance / speed
    local startTime = tick()
    
    -- Substitui o Tween por um loop de física em tempo real
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not _G.AutoFarmAtivo then connection:Disconnect() return end
        
        local elapsedTime = tick() - startTime
        local t = elapsedTime / timeToReach
        
        if t >= 1 then
            hrp.CFrame = CFrame.new(targetPosition)
            connection:Disconnect()
        else
            local nextPos = BezierCurve(t, startPos, p1, targetPosition)
            hrp.CFrame = CFrame.new(nextPos)
            -- Simula gravidade zero temporária
            if hrp:FindFirstChild("Velocity") then hrp.Velocity = Vector3.new(0,0,0) end
        end
    end)
    
    task.wait(timeToReach)
end

