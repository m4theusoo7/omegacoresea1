-- ==============================================================================
-- 🧠 O CÉREBRO: MATRIZ DE PRIORIDADE DINÂMICA
-- ==============================================================================
local function PegarDropPendente()
    -- Checa se existe algum Boss vivo que precisamos do item
    local levelAtual = player.Data.Level.Value
    for _, boss in pairs(BossDB) do
        if levelAtual >= boss.Level and not TemItem(boss.Drop) then
            local bossModel = workspace.Enemies:FindFirstChild(boss.Nome)
            if bossModel and bossModel:FindFirstChild("Humanoid") and bossModel.Humanoid.Health > 0 then
                return bossModel, boss
            end
        end
    end
    return nil, nil
end

local function ChecarBossEHop()
    -- Se tem um boss que precisa do item, mas ele NÃO está no mapa, Hop!
    local levelAtual = player.Data.Level.Value
    local precisaDeBoss = false
    
    for _, boss in pairs(BossDB) do
        if levelAtual >= boss.Level and not TemItem(boss.Drop) then
            local bossModel = workspace.Enemies:FindFirstChild(boss.Nome)
            if not bossModel then
                precisaDeBoss = true
                break
            end
        end
    end
    
    if precisaDeBoss and getgenv().Config.AutoHopBoss then
        getgenv().EstadoAtual = "Boss do seu Level sem Drop não está aqui. Dando Hop..."
        ServerHopInteligente() -- (Vem da Parte 1)
        task.wait(5)
    end
end

-- Função principal do loop (A State Machine)
local function LoopDeDecisao()
    task.spawn(function()
        while task.wait(0.1) do
            if not getgenv().Config.AutoFarm then continue end
            
            pcall(function()
                local levelAtual = player.Data.Level.Value
                
                -- PRIORIDADE 0: Comprar melhorias se possível
                ChecarEComprarItens()
                
                -- PRIORIDADE 1: FRUTA MÍTICA NO CHÃO
                local achouFruta = false
                for _, obj in pairs(workspace:GetChildren()) do
                    if obj.Name:find("Fruit") and obj:IsA("Tool") then
                        getgenv().EstadoAtual = "Coletando Fruta: " .. obj.Name
                        TweenVoo(obj.Handle.Position)
                        achouFruta = true
                        break
                    end
                end
                if achouFruta then return end -- Reinicia o loop

                -- PRIORIDADE 2: BOSSES E SEUS DROPS (COM SERVER HOP)
                local alvoBoss, dadosBoss = PegarDropPendente()
                if alvoBoss then
                    getgenv().EstadoAtual = "Farmando Drop: " .. dadosBoss.Drop .. " do " .. dadosBoss.Nome
                    TweenVoo(alvoBoss.HumanoidRootPart.Position)
                    AtacarAlvo(alvoBoss)
                    return -- Continua focando no boss
                else
                    -- Se o boss morreu e o item não veio (ele sumiu do mapa), checa se deve pular de server
                    ChecarBossEHop()
                end

                -- PRIORIDADE 3: QUEST SEA 2 (NÍVEL 700)
                if levelAtual >= 700 and getgenv().Config.AutoSea2 then
                    getgenv().EstadoAtual = "Resolvendo Quest do Sea 2..."
                    -- A lógica bruta da Quest do Sea 2 será engatada na Parte 3
                    return
                end

                -- PRIORIDADE 4: FARM DE LEVEL PADRÃO
                local questAtual = nil
                for _, q in pairs(QuestDB) do
                    if levelAtual >= q.Min and levelAtual <= q.Max then
                        questAtual = q
                        break
                    end
                end

                if questAtual then
                    getgenv().EstadoAtual = "Nível " .. levelAtual .. " | Farmando: " .. questAtual.Mob
                    
                    -- Pega a missão (O jogo ignora se já tiver pego)
                    PegarMissao(questAtual.Npc, questAtual.Quest, questAtual.QLevel)
                    
                    -- Acha o mob
                    local mobFound = false
                    for _, mob in pairs(workspace.Enemies:GetChildren()) do
                        if mob.Name == questAtual.Mob and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                            TweenVoo(mob.HumanoidRootPart.Position)
                            AtacarAlvo(mob)
                            mobFound = true
                            break
                        end
                    end
                    
                    -- Se os mobs acabaram no spot, levanta o voo pro anti-cheat não bugar no respawn
                    if not mobFound then
                        local char = player.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then
                            char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0, 20, 0)
                        end
                    end
                end
            end)
        end
    end)
end

