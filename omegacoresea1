--[[
    Blox Fruits - Quest Auto Farm Level 1 to 10 (Starter -> Jungle)
    Otimizado para Delta Executor
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- Configurações e Coordenadas
local SETTINGS = {
    StarterLevelMax = 10,
    QuestNPC = CFrame.new(1059.3, 16.5, 1549.5), -- Posição aproximada do NPC de Quest na Ilha Inicial
    MobPosition = CFrame.new(1159.2, 16.5, 1640.8), -- Posição dos Bandits/Pirates na Ilha Inicial
    JungleIsland = CFrame.new(-1251.1, 11.8, 3812.3), -- Posição da Ilha Jungle
}

local function getLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then
        return data.Level.Value
    end
    return 1
end

local function hasActiveQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local main = playerGui:FindFirstChild("Main")
        if main then
            local quest = main:FindFirstChild("Quest")
            if quest and quest.Visible then
                return true
            end
        end
    end
    return false
end

local function tweenTo(targetCFrame, speed)
    speed = speed or 300
    local distance = (HumanoidRootPart.Position - targetCFrame.Position).Magnitude
    local time = distance / speed
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(HumanoidRootPart, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    return tween
end

local function attackTarget()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    
    -- Dispara skills (Z, X, C, V)
    local vim = game:GetService("VirtualInputManager")
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, key, false, game)
    end
end

-- Loop Principal de Farm por Missões
task.spawn(function()
    print("[OmegaCore]: Auto Farm de Missões Iniciado (Level 1-10)")
    
    while true do
        task.wait(0.5)
        
        pcall(function()
            local currentLevel = getLevel()
            Character = LocalPlayer.Character
            if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
            HumanoidRootPart = Character.HumanoidRootPart
            
            if currentLevel < SETTINGS.StarterLevelMax then
                if not hasActiveQuest() then
                    -- Passo 1: Ir até o NPC e pegar a missão
                    tweenTo(SETTINGS.QuestNPC, 300)
                    if (HumanoidRootPart.Position - SETTINGS.QuestNPC.Position).Magnitude < 10 then
                        -- Dispara o evento remoto para aceitar a missão (Bandits/Quest inicial)
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
                        task.wait(1)
                    end
                else
                    -- Passo 2: Ir até os inimigos e farmar usando ataque + skills
                    local targetMob = nil
                    local shortestDistance = math.huge
                    
                    for _, mob in pairs(workspace.Enemies:GetChildren()) do
                        if mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                            local mobPart = mob:FindFirstChild("HumanoidRootPart")
                            if mobPart then
                                local dist = (HumanoidRootPart.Position - mobPart.Position).Magnitude
                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    targetMob = mobPart
                                end
                            end
                        end
                    end
                    
                    if targetMob then
                        tweenTo(targetMob.CFrame + Vector3.new(0, 10, 0), 350)
                        attackTarget()
                    else
                        tweenTo(SETTINGS.MobPosition + Vector3.new(0, 25, 0), 300)
                    end
                end
            else
                -- Passo 3: Level 10 Atingido - Viagem para a Ilha Jungle
                print("[OmegaCore]: Level 10 alcançado! Indo para a Ilha Jungle...")
                local tweenJungle = tweenTo(SETTINGS.JungleIsland + Vector3.new(0, 50, 0), 350)
                tweenJungle.Completed:Wait()
                print("[OmegaCore]: Chegou na Ilha Jungle com sucesso!")
                script:Destroy()
            end
        end)
    end
end)
