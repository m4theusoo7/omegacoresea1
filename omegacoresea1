-- Função de Teleporte Suave
local function SafeTween(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    
    -- Desativar colisão para evitar travamentos
    for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 300 -- Velocidade segura
    local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, info, {CFrame = targetCFrame + Vector3.new(0, 35, 0)})
    
    tween:Play()
    return tween
end

-- Disparador Inteligente de Skills (Z, X, C, V)
local function UseCombatSkills()
    if not getgenv().Sea1Config.UseSkills then return end
    local vim = game:GetService("VirtualInputManager")
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    
    for _, key in ipairs(keys) do
        pcall(function()
            vim:SendKeyEvent(true, key, false, game)
            task.wait(0.1)
            vim:SendKeyEvent(false, key, false, game)
            task.wait(0.2)
        end)
    end
end

-- Função para checar e equipar arma/estilo
local function EquipWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    if not backpack or not character then return end
    
    local targetToolName = getgenv().Sea1Config.WeaponMode
    local tool = character:FindFirstChildOfClass("Tool")
    
    if not tool or tool.Name ~= targetToolName then
        local found = backpack:FindFirstChild(targetToolName)
        if found then
            LocalPlayer.Character.Humanoid:EquipTool(found)
        end
    end
end

