-- MÓDULO 4: MEMORY-LEAK FREE SERVER HOP (PERSISTÊNCIA)
---------------------------------------------------------------------------
local function SmartServerHop()
    table.insert(VisitedServers, game.JobId)
    writefile(ServerHopFile, HttpService:JSONEncode(VisitedServers))
    
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    
    -- Função protegida para requisição HTTP dependendo da sintaxe do Executor
    local requestFunc = syn and syn.request or http and http.request or http_request or fluxus and fluxus.request or request
    if requestFunc then
        local response = requestFunc({Url = url, Method = "GET"})
        if response.StatusCode == 200 then
            local data = HttpService:JSONDecode(response.Body)
            for _, server in ipairs(data.data) do
                if server.playing < server.maxPlayers - 1 and server.id ~= game.JobId then
                    local alreadyVisited = false
                    for _, v in ipairs(VisitedServers) do
                        if v == server.id then alreadyVisited = true break end
                    end
                    if not alreadyVisited then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                        return
                    end
                end
            end
        end
    end
end

