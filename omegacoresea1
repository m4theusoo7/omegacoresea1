--[[
    Blox Fruits - Quest Auto Farm Corrigido (Level 1-10 -> Jungle)
    Otimizado para Delta Executor
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- Configurações e Coordenadas da Ilha Inicial (Marine / Pirate Starter)
local SETTINGS = {
    StarterLevelMax = 10,
    QuestNPC = CFrame.new(1059.3, 16.5, 1549.5),   -- NPC de Quest
    MobSpawn = CFrame.new(1159.2, 16.5, 1640.8),    -- Área de spawn dos Bandits
    JungleIsland = CFrame.new(-1251.1, 11.8, 3812.3) -- Ilha Jungle
}

local function getLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then
        return data.Level.Value
    end
    return 1
end

-- Verificação otimizada do painel de missão na tela
local function hasActiveQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local main = playerGui:FindFirstChild("Main")
        if main then
            local quest = main:FindFirstChild("Quest")
            if quest and quest.Visible then
                -- Verifica se o texto da missão realmente apareceu
                local container = quest:FindFirstChild("Container")
                if container then
                    local title = container:FindFirstChild("QuestTitle")
                    if title and title.Visible then
                        return true
                    end
                end
                return true
            end
        end
    end
    return false
end

local function tweenTo(targetCFrame, speed)
    speed = speed or 300
    if not HumanoidRootPart or not HumanoidRootPart.Parent then return end
    local distance = (HumanoidRootPart.Position - targetCFrame.Position).Magnitude
    local time = distance / speed
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(HumanoidRootPart, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    return tween
end

local function attackTarget()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    
    -- Dispara skills (Z, X, C, V)
    local vim = game:GetService("VirtualInputManager")
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, key, false, game)
    end
end

-- Loop Principal Atualizado
task.spawn(function()
    print("[OmegaCore]: Auto Farm Corrigido Iniciado (Level 1-10)")
    
    while true do
        task.wait(0.3)
        
        pcall(function()
            local currentLevel = getLevel()
            Character = LocalPlayer.Character
            if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
            HumanoidRootPart = Character.HumanoidRootPart
            
            if currentLevel < SETTINGS.StarterLevelMax then
                if not hasActiveQuest() then
                    -- Passo 1: Vai até o NPC e pega a missão via Remote
                    tweenTo(SETTINGS.QuestNPC, 350)
                    if (HumanoidRootPart.Position - SETTINGS.QuestNPC.Position).Magnitude < 15 then
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
                        task.wait(1)
                    end
                else
                    -- Passo 2: Missão ativa - Procura os Bandits reais no Workspace
                    local targetMob = nil
                    local shortestDistance = math.huge
                    
                    if workspace:FindFirstChild("Enemies") then
                        for _, mob in pairs(workspace.Enemies:GetChildren()) do
                            if mob.Name == "Bandit" and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                                local mobPart = mob:FindFirstChild("HumanoidRootPart")
                                if mobPart then
                                    local dist = (HumanoidRootPart.Position - mobPart.Position).Magnitude
                                    if dist < shortestDistance then
                                        shortestDistance = dist
                                        targetMob = mobPart
                                    end
                                end
                            end
                        end
                    end
                    
                    if targetMob then
                        -- Vai para cima do Bandido flutuando ligeiramente acima e ataca
                        tweenTo(targetMob.CFrame + Vector3.new(0, 8, 0), 350)
                        attackTarget()
                    else
                        -- Se não achar nenhum Bandit vivo, vai para o local de spawn padrão
                        tweenTo(SETTINGS.MobSpawn + Vector3.new(0, 20, 0), 300)
                    end
                end
            else
                -- Passo 3: Level 10 Atingido - Viagem para a Ilha Jungle
                print("[OmegaCore]: Level 10 alcançado! Indo para a Ilha Jungle...")
                local tweenJungle = tweenTo(SETTINGS.JungleIsland + Vector3.new(0, 50, 0), 350)
                tweenJungle.Completed:Wait()
                print("[OmegaCore]: Chegou na Ilha Jungle com sucesso!")
                script:Destroy()
            end
        end)
    end
end)
