-- 4. SERVER HOP PERSISTENTE (.json)
-- ==========================================
local function SalvarE PularServidor()
    local fileName = "Hop_History.json"
    local history = {}
    
    -- Verifica se o arquivo existe e lê os servidores antigos
    if isfile and isfile(fileName) then
        local success, decoded = pcall(function() return HttpService:JSONDecode(readfile(fileName)) end)
        if success then history = decoded end
    end
    
    -- Registra o servidor atual para não voltar nele
    history[game.JobId] = true
    if writefile then
        writefile(fileName, HttpService:JSONEncode(history))
    end
    
    -- Lógica da requisição HTTP para o Roblox puxando um novo JobId entraria aqui
    print("Histórico salvo localmente. Iniciando salto de servidor...")
end

