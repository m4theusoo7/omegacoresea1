-- Blox Fruits Sea 1: Auto-Farm Starter (Lv. 1 a 10) & Teleport para Jungle
-- Compatível com Delta Executor

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Configurações de Estado
getgenv().Config = {
    AutoFarm = true,
    SelectQuest = true,
    SelectedMonster = "Bandit [Lv. 5]",
    TargetLevel = 10,
    JunglePosition = CancellationToken and C3 or Vector3.new(-1249.3, 11.8, 327.5) -- Posição de chegada na Jungle
}

-- Função para verificar Level atual
local function GetLevel()
    if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") then
        return LocalPlayer.Data.Level.Value
    elseif LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Level") then
        return LocalPlayer.leaderstats.Level.Value
    end
    return 1
end

-- Função para aceitar missão automaticamente
local function AcceptQuest()
    pcall(function()
        if GetLevel() < 10 then
            -- Disparar evento de quest do Pirate Starter
            local args = {
                [1] = "StartQuest",
                [2] = "PirateQuest1",
                [3] = 1
            }
            ReplicatedStorage.Remotes.CommF_:InvokeServer(unpack(args))
        end
    end)
end

-- Função de Tween (Movimento suave até o alvo)
local function TweenTo(targetCFrame, speed)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local time = distance / (speed or 250)
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    return tween
end

-- Loop Principal de Execução
task.spawn(function()
    while task.wait(0.5) do
        if getgenv().Config.AutoFarm then
            local currentLevel = GetLevel()
            
            -- Condição para mudar para a Jungle ao atingir o Level 10
            if currentLevel >= getgenv().Config.TargetLevel then
                print("[Auto-Farm]: Level 10 atingido! Teleportando para a Jungle...")
                
                -- Teleporte suave para a Jungle Island
                local tween = TweenTo(CFrame.new(-1249.3, 15.0, 327.5), 300)
                if tween then
                    tween.Completed:Wait()
                end
                
                -- Desativa o loop de farm do starter
                getgenv().Config.AutoFarm = false
                break
            end
            
            -- Verificar se tem missão ativa
            local questUI = LocalPlayer.PlayerGui.Main.Quest
            if not questUI.Visible then
                AcceptQuest()
                task.wait(1)
            else
                -- Procurar inimigos (Bandit) próximos
                local enemies = workspace.Enemies:GetChildren()
                for _, enemy in pairs(enemies) do
                    if enemy.Name == "Bandit" and enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                        
                        repeat
                            task.wait()
                            if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then break end
                            
                            -- Ir até o Bandit mantendo uma pequena altura
                            LocalPlayer.Character.HumanoidRootPart.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 3, 3)
                            
                            -- Ativar ataques básicos (Click)
                            pcall(function()
                                game:GetService("VirtualUser"):Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                            end)
                            
                            -- Usar Habilidades em Loop (Z, X, C, V)
                            local vim = game:GetService("VirtualInputManager")
                            vim:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
                            task.wait(0.1)
                            vim:SendKeyEvent(false, Enum.KeyCode.Z, false, game)
                            
                            vim:SendKeyEvent(true, Enum.KeyCode.X, false, game)
                            task.wait(0.1)
                            vim:SendKeyEvent(false, Enum.KeyCode.X, false, game)
                            
                            vim:SendKeyEvent(true, Enum.KeyCode.C, false, game)
                            task.wait(0.1)
                            vim:SendKeyEvent(false, Enum.KeyCode.C, false, game)
                            
                            vim:SendKeyEvent(true, Enum.KeyCode.V, false, game)
                            task.wait(0.1)
                            vim:SendKeyEvent(false, Enum.KeyCode.V, false, game)
                            
                        until not enemy or not enemy:FindFirstChild("Humanoid") or enemy.Humanoid.Health <= 0 or not getgenv().Config.AutoFarm
                    end
                end
            end
        end
    end
end)
