local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Coordenada exata do NPC na Pirate Starter
local PirateStarterQuestNPC = CFrame.new(1062, 16, 1546)

local function tweenTo(targetCFrame)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 350
    local timeTake = distance / speed
    
    local tweenInfo = TweenInfo.new(timeTake, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()
end

local function getPirateStarterQuestSafely()
    local success, err = pcall(function()
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Data") then return end
        local playerLevel = LocalPlayer.Data.Level.Value
        
        if playerLevel < 10 then
            local questActive = LocalPlayer.PlayerGui.Main.Quest.Visible
            
            if not questActive then
                -- 1. Vai até o NPC
                tweenTo(PirateStarterQuestNPC)
                task.wait(0.2)
                
                -- 2. Aceita a missão via Remote
                if ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_") then
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
                end
                
                -- 3. ANTI-PUXÃO: Joga o personagem instantaneamente para fora da área de colisão do NPC
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = LocalPlayer.Character.HumanoidRootPart
                    -- Afasta o avatar 12 studs para trás e 4 para cima, quebrando o puxão do NPC
                    hrp.CFrame = PirateStarterQuestNPC * CFrame.new(0, 4, 12)
                end
                
                -- 4. Pequena pausa de estabilização da física
                task.wait(0.4)
            end
        end
    end)
    
    if not success then
        warn("[OmegaCore Error]: " .. tostring(err))
    end
end

-- Loop de verificação
task.spawn(function()
    while task.wait(1) do
        getPirateStarterQuestSafely()
    end
end)
