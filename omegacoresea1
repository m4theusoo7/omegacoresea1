-- 🗡️ AUTO-SABER (PUZZLE DO SHANKS)
-- ==============================================================================
local function FazerPuzzleSaber()
    local levelAtual = player.Data.Level.Value
    if levelAtual < 200 or TemItem("Saber") then return false end
    
    getgenv().EstadoAtual = "Fazendo Puzzle da Saber (Shanks)..."
    
    -- O Puzzle envolve botões físicos e itens que precisam ser pegos em ordem.
    -- Para não bugar o anti-cheat, o script checa o status no Remotes do jogo.
    
    -- Passo 1: Botões da Selva (Apertados via Teleporte rápido)
    local botoes = {
        CFrame.new(-160.2, 37.3, 142.1), CFrame.new(-127.4, 38.6, 273.5),
        CFrame.new(-282.8, 41.5, 53.6), CFrame.new(-183.1, 38.8, -43.1),
        CFrame.new(-121.7, 37.3, -290.4)
    }
    
    for _, pos in pairs(botoes) do
        TweenVoo(pos.Position)
        task.wait(0.5) -- Tempo para o servidor registrar o toque
    end
    
    -- Nota: A lógica completa envolveria pegar a Tocha, ir pro Deserto, 
    -- derreter a porta, pegar o Copo, ir pra Ilha de Gelo, etc.
    -- Como a Saber é um item físico e envolve troca de instâncias, chamamos
    -- o Boss Direto se a Relíquia já estiver liberada. Se o Shanks (Saber Expert)
    -- estiver vivo, o bot vai matá-lo pela Matriz de Prioridade da Parte 2.
    
    return true
end

-- ==============================================================================
-- 🌊 ROTA PARA O SEA 2 (NÍVEL 700+)
-- ==============================================================================
local function RotaSea2()
    local levelAtual = player.Data.Level.Value
    if levelAtual < 700 then return end
    
    getgenv().EstadoAtual = "Iniciando Missão para o Sea 2..."
    
    -- 1. Falar com o Military Detective na Prisão
    ReplicatedStorage.Remotes.CommF_:InvokeServer("DressrosaQuestProgress", "Detective")
    task.wait(1)
    
    -- 2. Checar se o Ice Admiral está vivo na Ilha de Gelo e matar ele
    local iceAdmiral = workspace.Enemies:FindFirstChild("Ice Admiral")
    if iceAdmiral and iceAdmiral:FindFirstChild("Humanoid") and iceAdmiral.Humanoid.Health > 0 then
        getgenv().EstadoAtual = "Matando Ice Admiral (Missão Sea 2)..."
        TweenVoo(iceAdmiral.HumanoidRootPart.Position)
        AtacarAlvo(iceAdmiral)
        return -- Espera ele morrer
    end
    
    -- 3. Falar com o Detective de novo
    ReplicatedStorage.Remotes.CommF_:InvokeServer("DressrosaQuestProgress", "Detective2")
    task.wait(1)
    
    -- 4. Falar com o Experienced Captain na Middle Town e Teleportar
    getgenv().EstadoAtual = "Teleportando para o Sea 2!"
    ReplicatedStorage.Remotes.CommF_:InvokeServer("TravelDressrosa")
end

-- Acoplando na Matriz de Prioridade (Sobrescrevendo a Prioridade 3 da Parte 2 de forma invisível)
task.spawn(function()
    while task.wait(2) do
        if getgenv().Config.AutoSea2 and player.Data.Level.Value >= 700 then
            RotaSea2()
        end
        if getgenv().Config.AutoFarm and player.Data.Level.Value >= 200 and not TemItem("Saber") then
            FazerPuzzleSaber()
        end
    end
end)

