-- 🧠 OMEGA CORE SEA 1 - PARTE 3 (LÓGICA DO AUTO FARM E COMBATE)
-- =====================================================================

local function GetQuestData()
    local myLevel = LocalPlayer.Data.Level.Value
    for _, data in pairs(QuestDatabase) do
        if myLevel >= data[1] and myLevel <= data[2] then
            return data
        end
    end
    return QuestDatabase[#QuestDatabase] -- Se passar do 700, continua na última quest
end

local function FarmQuest()
    local data = GetQuestData()
    local questName = data[3]
    local questNum = data[4]
    local mobName = data[5]
    local npcPos = data[6]
    local mobPos = data[7]
    
    local questActive = LocalPlayer.PlayerGui.Main.Quest.Visible
    local currentQuestName = LocalPlayer.PlayerGui.Main.Quest.Container.QuestTitle.Title.Text

    if not questActive or not string.find(currentQuestName, mobName) then
        -- Cancelar quest errada se houver
        if questActive then
            ReplicatedStorage.Remotes.CommF_:InvokeServer("AbandonQuest")
            task.wait(0.5)
        end
        
        -- Ir até o NPC
        SmartBypassMove(npcPos)
        task.wait(0.5)
        
        -- Puxar a Quest
        local npc = workspace.NPCs:FindFirstChild("Quest Giver") or workspace.NPCs:FindFirstChild(questName .. " Giver")
        if npc then
            ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questName, questNum)
        end
    else
        -- A Quest certa está ativa, procurar os monstros
        EquipWeapon()
        
        local mobEncontrado = false
        for _, mob in pairs(workspace.Enemies:GetChildren()) do
            if string.find(mob.Name, mobName) and mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health > 0 then
                mobEncontrado = true
                
                -- Anti-Borracha (Collision Bypass) para bater sem levar hit
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                end

                -- Ficar acima/atrás do monstro
                local targetPos = mob.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0)
                SmartBypassMove(targetPos)
                
                -- Atacar enquanto estiver vivo
                while mob.Humanoid.Health > 0 and _G.AutoFarmLv do
                    targetPos = mob.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0)
                    LocalPlayer.Character.HumanoidRootPart.CFrame = targetPos
                    
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                    task.wait(0.1)
                end
                break -- Depois de matar, sai do for e procura outro
            end
        end
        
        -- Se não achou monstro perto, vai pro spawn deles esperar
        if not mobEncontrado then
            SmartBypassMove(mobPos)
        end
    end
end

-- Loop Mestre do Farm Level
task.spawn(function()
    while task.wait() do
        if _G.AutoFarmLv then
            pcall(function() FarmQuest() end)
        end
    end
end)

-- Lógica dos Bosses (Drop Farm)
local function FarmBosses()
    local Bosses = {"The Saw", "Warden", "Chief Warden", "Swan", "Fishman Lord", "Thunder God", "Cyborg", "Saber Expert", "Ice Admiral"}
    while _G.AutoBossDrops do
        local bossFound = false
        for _, bossName in pairs(Bosses) do
            local boss = workspace.Enemies:FindFirstChild(bossName)
            if boss and boss:FindFirstChild("HumanoidRootPart") and boss.Humanoid.Health > 0 then
                bossFound = true
                EquipWeapon()
                while boss.Humanoid.Health > 0 and _G.AutoBossDrops do
                    local targetPos = boss.HumanoidRootPart.CFrame * CFrame.new(0, 15, 0)
                    SmartBypassMove(targetPos)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                    task.wait(0.1)
                end
            end
        end
        if not bossFound then task.wait(3) end
    end
end
